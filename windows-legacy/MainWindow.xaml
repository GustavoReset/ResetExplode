<Window x:Class="ResetExplode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ResetExplode"
        Title="RESET EXPLODE" Icon="Assets/app.ico" Width="1320" Height="840" MinWidth="1120" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Linha da tela "Sistema": folha = chave/valor; grupo = título + filhos (recursivo) -->
        <DataTemplate DataType="{x:Type local:InfoNode}">
            <StackPanel>
                <Border x:Name="leaf" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="group" Visibility="Collapsed" Margin="0,26,0,0">
                    <TextBlock Text="{Binding Header}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Children}"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter TargetName="leaf" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="group" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Placa de vídeo: campo (rótulo em cima, valor embaixo) e seção em cartão com 3 colunas -->
        <DataTemplate x:Key="GpuTile">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10,18,10">
                <StackPanel>
                    <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                    <TextBlock Text="{Binding Value}" FontSize="14" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GpuSection">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="20,16,20,8">
                <StackPanel>
                    <TextBlock Text="{Binding Header}" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                    <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource GpuTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Linha "rótulo ........ valor" (KeyValuePair) -->
        <DataTemplate x:Key="KeyValueRow">
            <Grid Margin="0,3">
                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}"/>
                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
            </Grid>
        </DataTemplate>

        <!-- Medidor horizontal: rótulo, valor e barra (Fraction 0..1) -->
        <DataTemplate x:Key="Meter">
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,6,0,0" Background="{DynamicResource Line}">
                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="MonoCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        </Style>
        <Style x:Key="MutedCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style x:Key="MutedMonoCell" TargetType="TextBlock" BasedOn="{StaticResource MonoCell}">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Barra de título (marca + página atual + botões da janela) ===== -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Image x:Name="TitleLogo" Source="Assets/logo.png" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="RESET" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text=" EXPLODE" FontWeight="Light" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitlePage" Foreground="{DynamicResource Faint}" FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnTheme" Style="{StaticResource CaptionButton}" Content="&#xE706;" Click="Theme_Click" ToolTip="Modo claro"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimizar"/>
                <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maximizar"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fechar"/>
            </StackPanel>

            <!-- ===== Menu lateral por categorias (painel arredondado, sempre visível) ===== -->
            <Border x:Name="Sidebar" Grid.Row="1" Margin="14,0,0,14" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20">
                <DockPanel>
                    <!-- Rodapé: aviso de sensores + leitura ao vivo compacta -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,6,16,16">
                        <Border x:Name="CpuSensorWarn" Visibility="Collapsed" BorderBrush="{DynamicResource Fg}" BorderThickness="1"
                                CornerRadius="12" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Sem temperatura e consumo da CPU" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CpuSensorWarnText" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="CORRIGIR" Padding="10,5" FontSize="11"
                                        Click="BtnFixCpuSensors_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="CPU" Foreground="{DynamicResource Faint}" FontSize="10.5" FontWeight="Bold" Margin="0,3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideTemp" Grid.Column="1" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                                <TextBlock x:Name="SideLoad" Grid.Column="2" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Text="GPU" Foreground="{DynamicResource Faint}" FontSize="10.5" FontWeight="Bold" Margin="0,3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideGpuTemp" Grid.Row="1" Grid.Column="1" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                                <TextBlock x:Name="SideGpuLoad" Grid.Row="1" Grid.Column="2" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Text="TESTE" Foreground="{DynamicResource Faint}" FontSize="10.5" FontWeight="Bold" Margin="0,3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideStress" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="parado" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SideVersion" Text="v0.16" Foreground="{DynamicResource Faint}" FontSize="11" Margin="4,10,0,0"/>
                    </StackPanel>

                    <!-- Navegação por categorias -->
                    <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                        <StackPanel Margin="0,0,0,10">
                            <RadioButton x:Name="NavDash" Style="{StaticResource NavItem}" Tag="PageDash" Checked="Nav_Checked" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Visão geral" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <ToggleButton x:Name="GrpExplode" Style="{StaticResource NavGroup}" Content="RESET EXPLODE"/>
                            <StackPanel x:Name="GrpExplodeItems" Margin="10,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpExplode, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" Tag="PageSystem" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sistema" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSensors" Style="{StaticResource NavItem}" Tag="PageSensors" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sensores" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavGpu" Style="{StaticResource NavItem}" Tag="PageGpu" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Placa de vídeo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDisks" Style="{StaticResource NavItem}" Tag="PageDisks" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Discos" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavEnergy" Style="{StaticResource NavItem}" Tag="PageEnergy" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Energia" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavNet" Style="{StaticResource NavItem}" Tag="PageNet" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE839;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Rede" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpGames" Style="{StaticResource NavGroup}" Content="RESET JOGOS"/>
                            <StackPanel x:Name="GrpGamesItems" Margin="10,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpGames, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavLauncher" Style="{StaticResource NavItem}" Tag="PageLauncher" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Biblioteca" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavGames" Style="{StaticResource NavItem}" Tag="PageGames" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC49;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="FPS estimado" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavBottleneck" Style="{StaticResource NavItem}" Tag="PageBottleneck" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Gargalo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavOverlay" Style="{StaticResource NavItem}" Tag="PageOverlay" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81E;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Overlay" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpPerf" Style="{StaticResource NavGroup}" Content="RESET DESEMPENHO"/>
                            <StackPanel x:Name="GrpPerfItems" Margin="10,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpPerf, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavBench" Style="{StaticResource NavItem}" Tag="PageBench" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Benchmark" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavStress" Style="{StaticResource NavItem}" Tag="PageStress" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stress test" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavOc" Style="{StaticResource NavItem}" Tag="PageOc" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Overclock" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpTools" Style="{StaticResource NavGroup}" Content="RESET FERRAMENTAS"/>
                            <StackPanel x:Name="GrpToolsItems" Margin="10,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpTools, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavOptimize" Style="{StaticResource NavItem}" Tag="PageOptimize" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F3;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Otimização" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" Tag="PageStartup" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Inicialização" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Tag="PageApps" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE719;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Instalar apps" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDriver" Style="{StaticResource NavItem}" Tag="PageDriver" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Drivers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavInteg" Style="{StaticResource NavItem}" Tag="PageInteg" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Integração" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpMaker" Style="{StaticResource NavGroup}" Content="RESET MAKER"/>
                            <StackPanel x:Name="GrpMakerItems" Margin="10,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpMaker, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavMakerPorts" Style="{StaticResource NavItem}" Tag="PageMakerPorts" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE88E;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Portas COM" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavMakerDrv" Style="{StaticResource NavItem}" Tag="PageMakerDrv" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE950;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Drivers seriais" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Conteúdo ===== -->
            <Grid Grid.Row="1" Grid.Column="1">

                <!-- ===== VISÃO GERAL (painel) ===== -->
                <ScrollViewer x:Name="PageDash" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,6,24,20">

                        <!-- Linha 1: gráfico grande + desempenho -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardBorder}" Padding="24,20">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="DashChartLabel" Text="CPU · TEMPERATURA" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="DashChartDelta" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                            <TextBlock x:Name="DashChartValue" Text="—" Style="{StaticResource Hero}" FontFamily="{StaticResource Mono}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                            <TextBlock Text="GPU" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="DashChartValue2" Text="—" FontFamily="{StaticResource Mono}" FontSize="22"
                                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,16,0,8">
                                        <StackPanel x:Name="DashRangePanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashRange" Content="1 MIN" Tag="60" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashRange" Content="5 MIN" Tag="300" IsChecked="True" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashRange" Content="15 MIN" Tag="900" Checked="DashOption_Checked"/>
                                        </StackPanel>
                                        <StackPanel x:Name="DashMetricPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashMetric" Content="Temperatura" Tag="temp" IsChecked="True" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashMetric" Content="Carga" Tag="load" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashMetric" Content="Consumo" Tag="power" Checked="DashOption_Checked"/>
                                        </StackPanel>
                                    </Grid>
                                    <Canvas x:Name="DashChart" Height="210" ClipToBounds="True" SizeChanged="DashChart_SizeChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Rectangle Width="14" Height="2" Fill="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="CPU" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                                        <Line X1="0" X2="14" Stroke="{DynamicResource Muted}" StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="GPU" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Desempenho (como o "Total Balance" da referência) -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="22,20">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="RODAR BENCHMARK" Margin="0,14,0,0"
                                            Padding="20,13" Click="DashBench_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="DESEMPENHO · RESET BENCH" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <TextBlock x:Name="DashScore" Text="—" Style="{StaticResource Hero}" FontFamily="{StaticResource Mono}"/>
                                            <TextBlock x:Name="DashScoreDelta" Foreground="{DynamicResource Muted}" FontSize="12"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="DashScoreSub" Text="multi-core · nenhum teste ainda" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,0"/>
                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,16"/>
                                        <ItemsControl x:Name="DashScores" ItemTemplate="{StaticResource KeyValueRow}"/>
                                        <!-- Caixa interna, como o widget de troca da referência -->
                                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"
                                                Padding="14,4" Margin="0,14,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,10">
                                                    <TextBlock Text="CPU" Foreground="{DynamicResource Muted}"/>
                                                    <TextBlock x:Name="DashCpuName" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="50,0,0,0"/>
                                                </Grid>
                                                <Border Height="1" Background="{DynamicResource Line}"/>
                                                <Grid Margin="0,10">
                                                    <TextBlock Text="GPU" Foreground="{DynamicResource Muted}"/>
                                                    <TextBlock x:Name="DashGpuName" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="50,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Linha 2: tabela de componentes -->
                        <Border Style="{StaticResource CardBorder}" Padding="22,14,22,8" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="COMPONENTE" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="TEMPERATURA" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="2" Text="CARGA" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="3" Text="CLOCK" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="4" Text="CONSUMO / USO" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="5" Text="VER" Style="{StaticResource Label}" Margin="0" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl x:Name="DashComponents">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="56"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Hover}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                            <TextBlock Text="{Binding Model}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Temp}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Load}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Clock}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Power}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="5" Style="{StaticResource CaptionButton}" Width="30" Height="30" Content="&#xE72A;"
                                                            HorizontalAlignment="Right" Tag="{Binding Target}" Click="DashGo_Click" ToolTip="Abrir detalhes"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Linha 3: anéis de memória, eventos e saúde -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Anéis concêntricos (como o "Annual Profit" da referência) -->
                            <Border Style="{StaticResource CardBorder}" Padding="22,20">
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA E DISCO" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DashMemHero" Text="—" Style="{StaticResource Hero}" FontFamily="{StaticResource Mono}" FontSize="28"/>
                                    <TextBlock x:Name="DashMemSub" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,8"/>
                                    <Canvas x:Name="DashRings" Width="190" Height="190" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                    <ItemsControl x:Name="DashRingLegend">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="12" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Eventos recentes (como "Transactions") -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="22,20">
                                <StackPanel>
                                    <TextBlock Text="Eventos recentes" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="DashEventsEmpty" Text="Nada ainda. Benchmarks, testes e dispositivos conectados aparecem aqui."
                                               Foreground="{DynamicResource Faint}" TextWrapping="Wrap" FontSize="12"/>
                                    <ItemsControl x:Name="DashEvents">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Fg}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Ink}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding When}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Saúde do PC (como "Rewards"): lista de verificação + ação -->
                            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="22,20">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="RESET OTIMIZA" Padding="20,13"
                                            Margin="0,14,0,0" Click="DashOptimize_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="Saúde do PC" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="DashHealth">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,11">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="chk" Text="&#xE739;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Faint}"
                                                                       Margin="0,0,12,0" VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter TargetName="chk" Property="Text" Value="&#xE73D;"/>
                                                        <Setter TargetName="chk" Property="Foreground" Value="{DynamicResource Fg}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== SISTEMA ===== -->
                <Grid x:Name="PageSystem" Margin="36,30,36,30" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,24">
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="Sistema" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="SystemSub" Text="Hardware e software detectados" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="BtnReport" Style="{StaticResource OutlineButton}" Content="EXPORTAR RELATÓRIO" Padding="16,9"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnReport_Click"
                                ToolTip="Salva um relatório (HTML ou JSON) com sistema, RAM, discos, GPU, sensores e benchmarks. Números de série são omitidos."/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="InfoCategories" ItemContainerStyle="{StaticResource ListNavItem}"
                                 SelectionChanged="InfoCategories_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Header}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="26,8,26,22">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="InfoTitle" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,8"/>

                                    <!-- Unidades (só em Armazenamento): anel de cheio/vazio por letra -->
                                    <StackPanel x:Name="DrivesPanel" Visibility="Collapsed" Margin="0,4,0,8">
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="UNIDADES" Style="{StaticResource Label}" Margin="0"/>
                                            <TextBlock x:Name="DrivesSummary" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ItemsControl x:Name="DriveCards">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="16,14" Margin="0,0,10,10"
                                                            Background="{DynamicResource Bg}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Anel: trilha cinza = vazio, arco branco = usado -->
                                                            <Grid Width="84" Height="84" Margin="0,0,16,0" VerticalAlignment="Center">
                                                                <Ellipse Width="72" Height="72" Stroke="{DynamicResource Line}" StrokeThickness="8"/>
                                                                <Path Data="{Binding UsedArc}" Stroke="{DynamicResource Fg}" StrokeThickness="8" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
                                                                <TextBlock Text="{Binding UsedPercent}" FontFamily="{StaticResource Mono}" FontSize="15"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Sizes}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="DISCOS FÍSICOS" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                                    </StackPanel>

                                    <ItemsControl x:Name="InfoDetails"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== DISCOS (saúde) ===== -->
                <ScrollViewer x:Name="PageDisks" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,160,0">
                                <TextBlock Text="Discos" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="DiskHealthStatus" Text="Saúde, desgaste e temperatura de cada disco" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnDiskRefresh" Style="{StaticResource OutlineButton}" Content="ATUALIZAR" Padding="18,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnDiskRefresh_Click"/>
                        </Grid>

                        <ItemsControl x:Name="DiskCards">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Margin="0,0,130,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{DynamicResource Fg}" BorderThickness="1" Padding="12,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Fg}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding VerdictText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Reasons}" TextWrapping="Wrap" Margin="0,12,0,12"/>
                                            <ItemsControl ItemsSource="{Binding Metrics}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8,16,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                            Os dados vêm do Windows (S.M.A.R.T. e API de armazenamento) e dos sensores do disco. Pendrives e alguns HDs externos
                            não informam saúde. O veredito é uma estimativa: faça backup de qualquer disco com aviso, não só dos críticos.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== ENERGIA (bateria e fonte) ===== -->
                <ScrollViewer x:Name="PageEnergy" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,160,0">
                                <TextBlock Text="Energia" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="EnergyStatus" Text="Bateria, fonte de energia e consumo" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnEnergyRefresh" Style="{StaticResource OutlineButton}" Content="ATUALIZAR" Padding="18,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnEnergyRefresh_Click"/>
                        </Grid>
                        <ItemsControl x:Name="EnergyCards" ItemTemplate="{StaticResource CardTemplate}"/>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                            Os dados vêm do Windows (WMI). Alguns notebooks não informam ciclos de carga ou a capacidade de projeto.
                            O consumo mostrado vem dos sensores de CPU e GPU, não da fonte (PSU) do PC.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== REDE (diagnóstico de lag) ===== -->
                <ScrollViewer x:Name="PageNet" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,160,0">
                                <TextBlock Text="Rede" Style="{StaticResource H1}"/>
                                <TextBlock Text="Descubra se o lag vem do seu PC, do Wi-Fi ou do provedor" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnNetTest" Style="{StaticResource PrimaryButton}" Content="TESTAR" Padding="22,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnNetTest_Click"/>
                        </Grid>
                        <Grid Height="3" Margin="0,0,0,8" Background="{DynamicResource Line}">
                            <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="NetProgress" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="NetStatus" Text="Pronto. O teste leva cerca de 30 segundos." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <ItemsControl x:Name="NetCards" ItemTemplate="{StaticResource CardTemplate}"/>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                            O teste envia pacotes de ping ao roteador e aos DNS públicos 1.1.1.1 e 8.8.8.8 e baixa/envia dados de teste do servidor público
                            speed.cloudflare.com (cerca de 100 MB no total). Feche downloads, streaming e jogos antes para um resultado fiel.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== RESET DRIVER ===== -->
                <ScrollViewer x:Name="PageDriver" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,190,0">
                                <TextBlock Text="RESET DRIVER" Style="{StaticResource H1}"/>
                                <TextBlock Text="Verifique, baixe e instale drivers · NVIDIA e AMD automáticos, fabricantes pela página oficial" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnDrvScan" Style="{StaticResource PrimaryButton}" Content="VERIFICAR TUDO" Padding="20,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnDrvScan_Click"/>
                        </Grid>
                        <Grid Height="3" Margin="0,0,0,8" Background="{DynamicResource Line}">
                            <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="DrvProgress" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="DrvStatus" Text="Clique em VERIFICAR TUDO." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="PLACA DE VÍDEO" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="DrvGpus">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="{Binding GpuName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0">
                                                    <Run Text="Instalado: "/><Run Text="{Binding Installed, Mode=OneWay}"/>
                                                    <Run Text="  ·  Mais recente: "/><Run Text="{Binding Latest, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox x:Name="DrvStudio" Content="Driver Studio (criação) em vez de Game Ready" Margin="0,14,0,0"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="BtnDrvInstall" Style="{StaticResource PrimaryButton}" Content="BAIXAR E INSTALAR" Padding="18,8" Margin="0,0,10,8" Click="BtnDrvInstall_Click" IsEnabled="False"/>
                                    <Button x:Name="BtnDrvGpuPage" Style="{StaticResource OutlineButton}" Content="ABRIR PÁGINA OFICIAL" Padding="18,8" Margin="0,0,10,8" Click="BtnDrvGpuPage_Click"/>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                                    NVIDIA: o instalador é baixado do servidor oficial, a assinatura digital é conferida e um ponto de restauração é criado antes de abrir.
                                    AMD: o programa procura o instalador na página oficial do seu modelo (RX série 4000 a 9000); se o site bloquear, use ABRIR PÁGINA OFICIAL. Intel: só a página oficial.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="PLACA-MÃE / FABRICANTE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="DrvBoard" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="BtnDrvBoardPage" Style="{StaticResource OutlineButton}" Content="ABRIR SUPORTE DO FABRICANTE" Padding="18,8" Margin="0,14,0,8"
                                        HorizontalAlignment="Left" Click="BtnDrvBoardPage_Click" IsEnabled="False"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                                    ASUS, MSI, Gigabyte e outros não têm API pública de versões. Abrimos o suporte oficial do fabricante detectado
                                    (chipset, áudio, rede, BIOS). Se a página não abrir no seu modelo, digite o modelo mostrado acima na busca do site.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="WINDOWS UPDATE (DRIVERS CERTIFICADOS)" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="DrvWuList" Margin="0,10,0,0" TextWrapping="Wrap" Text="Ainda não pesquisado."/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="BtnDrvWuSearch" Style="{StaticResource OutlineButton}" Content="PROCURAR" Padding="18,8" Margin="0,0,10,8" Click="BtnDrvWuSearch_Click"/>
                                    <Button x:Name="BtnDrvWuInstall" Style="{StaticResource PrimaryButton}" Content="INSTALAR TODOS" Padding="18,8" Margin="0,0,10,8" Click="BtnDrvWuInstall_Click" IsEnabled="False"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="BACKUP DOS DRIVERS" Style="{StaticResource Label}"/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                           Text="Exporta todos os drivers de terceiros para Documentos\ResetExplode-Drivers. Útil antes de formatar ou de trocar um driver."/>
                                <Button x:Name="BtnDrvBackup" Style="{StaticResource OutlineButton}" Content="FAZER BACKUP" Padding="18,8" Margin="0,14,0,0"
                                        HorizontalAlignment="Left" Click="BtnDrvBackup_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="DRIVERS INSTALADOS" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="DrvList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Device}" TextWrapping="Wrap"/>
                                                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="11">
                                                        <Run Text="{Binding Class, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Vendor, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="11" TextAlignment="Right" Margin="12,0,0,0">
                                                    <Run Text="{Binding Version, Mode=OneWay}"/><LineBreak/><Run Text="{Binding Date, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SignedText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== RESET INTEGRAÇÃO (iluminação) ===== -->
                <ScrollViewer x:Name="PageInteg" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,190,0">
                                <TextBlock Text="RESET INTEGRAÇÃO" Style="{StaticResource H1}"/>
                                <TextBlock Text="Iluminação e efeitos do PC · Corsair iCUE, OpenRGB (MSI, Gigabyte, ASUS...) e Razer Chroma (em teste)" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnLightConnect" Style="{StaticResource OutlineButton}" Content="CONECTAR TUDO" Padding="20,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnLightConnect_Click"/>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="INTEGRAÇÕES" Style="{StaticResource Label}"/>

                                <TextBlock Text="Corsair iCUE / iCUE LINK" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                <TextBlock x:Name="LightStatus" Text="Aguardando…" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                <Button x:Name="BtnLightSdk" Style="{StaticResource OutlineButton}" Content="BAIXAR O SDK DA CORSAIR" Visibility="Collapsed"
                                        HorizontalAlignment="Left" Padding="20,9" Margin="0,10,0,0" Click="BtnLightSdk_Click"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                    Requer o iCUE aberto com o SDK ativado nas configurações (manual, dentro do iCUE). A DLL do SDK é baixada pelo botão acima.
                                </TextBlock>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="OpenRGB · MSI Mystic Light, Gigabyte RGB Fusion, ASUS Aura, RAM, Razer, Logitech e outras" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="OrgbStatus" Text="Aguardando…" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                        <Button x:Name="BtnOrgbOpen" Style="{StaticResource OutlineButton}" Content="ABRIR O OPENRGB"
                                                HorizontalAlignment="Left" Padding="20,9" Margin="0,10,0,0" Click="BtnOrgbOpen_Click"/>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                            A MSI, a Gigabyte e a ASUS não oferecem SDK público; o OpenRGB (gratuito, openrgb.org) conversa com os controladores delas.
                                            Ele precisa estar aberto com o servidor SDK ligado, e o MSI Center, o Armoury Crate e o RGB Fusion devem estar fechados.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Razer Chroma" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="RazerStatus" Text="Aguardando…" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                            Requer o Razer Synapse instalado e aberto. Controla cada categoria (teclado, mouse, headset...) com uma cor só.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="DISPOSITIVOS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="LightDevicesHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="LightDevices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="EFEITO" Style="{StaticResource Label}"/>
                                <WrapPanel x:Name="LightFxPanel" Margin="0,4,0,12">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Cor fixa" Tag="static" IsChecked="True" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Respiração" Tag="breath" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Arco-íris" Tag="rainbow" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Temperatura da CPU" Tag="cpu" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Temperatura da GPU" Tag="gpu" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Carga da CPU" Tag="load" Checked="LightFx_Checked"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LightFx" Content="Apagar" Tag="off" Checked="LightFx_Checked"/>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16">
                                    Temperatura e carga mudam a cor sozinhas (azul = frio/ocioso, verde, amarelo, vermelho = quente/carga alta).
                                    Cor fixa e Respiração usam a cor escolhida abaixo.
                                </TextBlock>

                                <TextBlock Text="COR" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                    <Border x:Name="LightPreview" Width="46" Height="46" Margin="0,0,16,0" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" VerticalAlignment="Top"/>
                                    <WrapPanel x:Name="LightSwatches" Width="360"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,2"><TextBlock Text="VERMELHO" Style="{StaticResource Label}"/></Grid>
                                <Slider x:Name="LightR" Minimum="0" Maximum="255" Value="255" ValueChanged="LightColor_Changed"/>
                                <Grid Margin="0,8,0,2"><TextBlock Text="VERDE" Style="{StaticResource Label}"/></Grid>
                                <Slider x:Name="LightG" Minimum="0" Maximum="255" Value="255" ValueChanged="LightColor_Changed"/>
                                <Grid Margin="0,8,0,2"><TextBlock Text="AZUL" Style="{StaticResource Label}"/></Grid>
                                <Slider x:Name="LightB" Minimum="0" Maximum="255" Value="255" ValueChanged="LightColor_Changed"/>

                                <Grid Margin="0,16,0,2">
                                    <TextBlock Text="BRILHO" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="LightBrightText" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LightBright" Minimum="0" Maximum="100" Value="100" ValueChanged="LightColor_Changed"/>
                                <Grid Margin="0,8,0,2">
                                    <TextBlock Text="VELOCIDADE (RESPIRAÇÃO E ARCO-ÍRIS)" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="LightSpeedText" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="LightSpeed" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LightColor_Changed"/>

                                <CheckBox x:Name="LightExclusive" Content="Controle exclusivo (Corsair: se não mudar nada, desmarque e tente de novo)" IsChecked="True" Margin="0,16,0,0"/>

                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="BtnLightRun" Style="{StaticResource PrimaryButton}" Content="ATIVAR CONTROLE"
                                            Padding="24,10" Margin="0,0,14,0" Click="BtnLightRun_Click"/>
                                    <TextBlock x:Name="LightLive" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" FontFamily="{StaticResource Mono}"/>
                                </WrapPanel>
                                <TextBlock x:Name="LightRunHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="DIAGNÓSTICO" Style="{StaticResource Label}"/>
                                <TextBox x:Name="LightDiag" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap"
                                         MinHeight="90" MaxHeight="260" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                                    Se as luzes não mudarem, copie este quadro e me envie.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== RESET JOGOS (inicializador) ===== -->
                <Grid x:Name="PageLauncher" Margin="36,30,36,30" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista de jogos -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="RESET JOGOS" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="LGameCount" Text="Procurando seus jogos…" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBox x:Name="LGameSearch" Tag="Buscar jogo…" TextChanged="LGameSearch_Changed" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button x:Name="BtnScanGames" Style="{StaticResource OutlineButton}" Content="ATUALIZAR LISTA" Padding="14,8" Margin="0,0,8,0" Click="BtnScanGames_Click"/>
                                <Button Style="{StaticResource OutlineButton}" Content="+ ADICIONAR .EXE" Padding="14,8" Click="BtnAddExe_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <ListBox x:Name="LGameList" Grid.Row="2" ItemContainerStyle="{StaticResource ListNavItem}" SelectionChanged="LGameList_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Detalhes do jogo -->
                    <TextBlock x:Name="LEmpty" Grid.Column="2" Text="Escolha um jogo na lista." Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,60,0,0"/>
                    <ScrollViewer x:Name="LDetail" Grid.Column="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <Grid Margin="0,0,0,6">
                                <StackPanel Margin="0,0,200,0">
                                    <TextBlock x:Name="LTitle" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LSub" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="BtnPlay" Style="{StaticResource PrimaryButton}" Content="JOGAR" Padding="40,14" FontSize="16"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnPlay_Click"/>
                            </Grid>
                            <TextBlock x:Name="LStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <!-- Desempenho -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="DESEMPENHO" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Prioridade do processo" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                                    <WrapPanel x:Name="LPriorityPanel" Margin="0,4,0,10">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LPriority" Content="Normal" Tag="normal" IsChecked="True" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LPriority" Content="Acima do normal" Tag="above" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LPriority" Content="Alta" Tag="high" Checked="LProfile_Changed"/>
                                </WrapPanel>
                                    <CheckBox x:Name="LChkPlan" Content="Plano de energia Alto desempenho enquanto joga (volta ao normal depois)" Margin="0,0,0,10" Click="LProfile_Changed"/>
                                    <CheckBox x:Name="LChkGpu" Content="Forçar a placa de vídeo dedicada (configuração gráfica do Windows)" Margin="0,0,0,10" Click="LProfile_Changed"/>
                                    <CheckBox x:Name="LChkFso" Content="Desativar otimizações de tela cheia do Windows" Margin="0,0,0,12" Click="LProfile_Changed"/>
                                    <TextBlock x:Name="LExeText" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource OutlineButton}" Content="ESCOLHER O .EXE" Padding="14,8" Margin="0,0,8,0" Click="BtnPickExe_Click"/>
                                        <Button Style="{StaticResource OutlineButton}" Content="PERFIL PARA MAIS FPS" Padding="14,8" Click="BtnRecommended_Click"/>
                                    </WrapPanel>
                                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                        Prioridade e plano de energia valem só durante o jogo. As opções de GPU e tela cheia são gravadas para o .exe do jogo no Windows
                                        (o programa descobre o .exe sozinho; se errar, escolha o certo).
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Gráficos -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="GRÁFICOS (ARGUMENTOS DE INICIALIZAÇÃO)" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Modo de janela" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                                    <WrapPanel x:Name="LModePanel" Margin="0,4,0,10">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LMode" Content="Padrão do jogo" Tag="default" IsChecked="True" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LMode" Content="Tela cheia" Tag="full" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LMode" Content="Sem bordas" Tag="borderless" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LMode" Content="Janela" Tag="window" Checked="LProfile_Changed"/>
                                </WrapPanel>
                                    <TextBlock Text="Resolução" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <WrapPanel x:Name="LResPanel" Margin="0,4,0,10">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LRes" Content="Padrão" Tag="default" IsChecked="True" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LRes" Content="1280x720" Tag="1280x720" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LRes" Content="1920x1080" Tag="1920x1080" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LRes" Content="2560x1440" Tag="2560x1440" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LRes" Content="3840x2160" Tag="3840x2160" Checked="LProfile_Changed"/>
                                </WrapPanel>
                                    <TextBlock Text="Taxa de atualização (Hz)" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <WrapPanel x:Name="LHzPanel" Margin="0,4,0,10">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="Padrão" Tag="0" IsChecked="True" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="60" Tag="60" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="120" Tag="120" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="144" Tag="144" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="165" Tag="165" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LHz" Content="240" Tag="240" Checked="LProfile_Changed"/>
                                </WrapPanel>
                                    <TextBlock Text="Tipo de argumento (depende do jogo)" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <WrapPanel x:Name="LStylePanel" Margin="0,4,0,10">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LStyle" Content="Source / CS2" Tag="source" IsChecked="True" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LStyle" Content="Unity" Tag="unity" Checked="LProfile_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="LStyle" Content="Unreal" Tag="unreal" Checked="LProfile_Changed"/>
                                </WrapPanel>
                                    <TextBlock Text="Extras" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <TextBox x:Name="LExtra" Tag="ex.: -novid -high +fps_max 0" Margin="0,4,0,8" TextChanged="LExtra_Changed"/>
                                    <WrapPanel x:Name="LExtraPresets" Margin="0,0,0,12"/>
                                    <TextBlock Text="LINHA FINAL" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="LPreview" FontFamily="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <StackPanel x:Name="LSteamBox" Visibility="Collapsed">
                                        <TextBlock x:Name="LSteamNow" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Button x:Name="BtnSteamApply" Style="{StaticResource PrimaryButton}" Content="APLICAR NAS OPÇÕES DA STEAM"
                                                HorizontalAlignment="Left" Padding="20,9" Click="BtnSteamApply_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LGfxNote" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Programas auxiliares -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="PROGRAMAS AUXILIARES" Style="{StaticResource Label}"/>
                                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10">
                                        Ferramentas de terceiros que abrem antes do jogo (monitoramento, comandos, mixer de áudio, script...). O RESET JOGOS as abre
                                        sozinho ao clicar em JOGAR e pode fechá-las junto com o jogo. Nada é escrito nas opções da Steam.
                                    </TextBlock>
                                    <ItemsControl x:Name="LHelpers">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,90,0"/>
                                                    <Button Style="{StaticResource OutlineButton}" Content="REMOVER" Padding="10,4" FontSize="11" Tag="{Binding}"
                                                            HorizontalAlignment="Right" Click="BtnRemoveHelper_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Style="{StaticResource OutlineButton}" Content="+ ADICIONAR PROGRAMA" Padding="14,8" Margin="0,0,14,0" Click="BtnAddHelper_Click"/>
                                        <CheckBox x:Name="LHelperClose" Content="Fechar junto com o jogo" IsChecked="True" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===== SENSORES ===== -->
                <Grid x:Name="PageSensors" Margin="36,30,36,30" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Sensores" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="StatusText" Text="Lendo sensores…" Style="{StaticResource Sub}"/>
                        </StackPanel>
                        <TextBox x:Name="SensorSearch" Width="260" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Tag="Buscar sensor ou hardware…" TextChanged="SensorSearch_Changed"/>
                    </Grid>
                    <WrapPanel x:Name="CategoryChips" Grid.Row="1" Margin="0,0,0,14"/>
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="6,14,6,6">
                        <DataGrid x:Name="SensorGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserResizeColumns="False">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="12,22,0,8"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SENSOR" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Category}" Width="130" ElementStyle="{StaticResource MutedCell}"/>
                                <DataGridTextColumn Header="VALOR" Binding="{Binding Value}" Width="130" ElementStyle="{StaticResource MonoCell}"/>
                                <DataGridTextColumn Header="MÍN." Binding="{Binding Min}" Width="120" ElementStyle="{StaticResource MutedMonoCell}"/>
                                <DataGridTextColumn Header="MÁX." Binding="{Binding Max}" Width="120" ElementStyle="{StaticResource MutedMonoCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ===== PLACA DE VÍDEO ===== -->
                <Grid x:Name="PageGpu" Margin="36,30,36,30" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Placa de vídeo" Style="{StaticResource H1}"/>
                            <TextBlock Text="Especificações completas e sensores em tempo real" Style="{StaticResource Sub}"/>
                        </StackPanel>
                        <WrapPanel x:Name="GpuChips" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- Destaque -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="24,20">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="GpuName" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GpuSubtitle" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="GpuVendor" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="30" FontWeight="Black" Foreground="{DynamicResource Faint}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="330"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <ItemsControl x:Name="GpuSections" ItemTemplate="{StaticResource GpuSection}"/>
                        </ScrollViewer>

                        <!-- Sensores (equivalente à aba Sensors do GPU-Z) -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,16,12,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="SENSORES AO VIVO" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="GpuExtras" DockPanel.Dock="Top" Margin="0,0,8,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}"/>
                                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="GpuLive" Margin="0,0,8,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,6">
                                                    <Grid>
                                                        <TextBlock>
                                                            <Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource Faint}"/>
                                                            <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== JOGOS ===== -->
                <Grid x:Name="PageGames" Margin="36,30,36,30" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Jogos" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="GamesSub" Text="FPS esperado no seu PC" Style="{StaticResource Sub}"/>
                        </StackPanel>
                        <TextBox x:Name="GameSearch" Width="260" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Tag="Buscar jogo…" TextChanged="GameSearch_Changed"/>
                    </Grid>

                    <!-- Configuração -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <WrapPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="RESOLUÇÃO" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="GameResPanel" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameRes" Content="1080p" Tag="1920x1080" Margin="0,0,6,0" IsChecked="True" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameRes" Content="1440p" Tag="2560x1440" Margin="0,0,6,0" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameRes" Content="4K" Tag="3840x2160" Margin="0" Checked="GameOption_Changed"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="GamePresetBox" Margin="0,0,32,0">
                                <TextBlock Text="GRÁFICOS" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="GamePresetPanel" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GamePreset" Content="Baixo" Tag="Baixo" Margin="0,0,6,0" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GamePreset" Content="Médio" Tag="Médio" Margin="0,0,6,0" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GamePreset" Content="Alto" Tag="Alto" Margin="0,0,6,0" IsChecked="True" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GamePreset" Content="Ultra" Tag="Ultra" Margin="0" Checked="GameOption_Changed"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="UPSCALING (DLSS / FSR)" Style="{StaticResource Label}"/>
                                <StackPanel x:Name="GameUpscalePanel" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameUp" Content="Nativo" Tag="Native" Margin="0,0,6,0" IsChecked="True" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameUp" Content="Qualidade" Tag="Quality" Margin="0,0,6,0" Checked="GameOption_Changed"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="GameUp" Content="Desempenho" Tag="Performance" Margin="0" Checked="GameOption_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Fonte dos dados -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="GameSourceTitle" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GameSourceText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Grid Width="240" Margin="0,0,8,0">
                                    <PasswordBox x:Name="ApiKeyBox" ToolTip="Chave da API HowManyFPS" PasswordChanged="ApiKeyBox_Changed"/>
                                    <TextBlock x:Name="ApiKeyHint" Text="Chave da API HowManyFPS" Foreground="{DynamicResource Faint}"
                                               Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <Button x:Name="BtnApiKey" Style="{StaticResource OutlineButton}" Content="SALVAR CHAVE" Padding="16,8"
                                        Click="BtnApiKey_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cartões dos jogos -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl x:Name="GameList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Genre}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,10"/>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FpsText}" FontFamily="{StaticResource Mono}" FontSize="30"/>
                                                    <TextBlock Text=" FPS" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Rating}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                                            </Grid>
                                            <!-- Barra: escala até 240 FPS -->
                                            <Grid Height="3" Margin="0,8,0,8" Background="{DynamicResource Line}">
                                                <Border Background="{DynamicResource Fg}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Bar}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="{Binding LowText}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                                <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ===== GARGALO ===== -->
                <ScrollViewer x:Name="PageBottleneck" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Detector de gargalo" Style="{StaticResource H1}"/>
                            <TextBlock Text="Descobre o que está limitando o seu FPS: GPU, CPU, memória ou temperatura" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Equilíbrio teórico -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="EQUILÍBRIO DO HARDWARE" Style="{StaticResource Label}"/>
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock x:Name="BnCpuName" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock x:Name="BnGpuName" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <!-- Escala: esquerda = GPU fraca para a CPU; centro = equilibrado; direita = CPU fraca para a GPU -->
                                    <Grid Height="22" Margin="0,8,0,4">
                                        <Border Height="4" Background="{DynamicResource Line}" VerticalAlignment="Center"/>
                                        <Border Width="2" Height="10" Background="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Canvas x:Name="BnBalanceCanvas" SizeChanged="BnBalanceCanvas_SizeChanged">
                                            <Ellipse x:Name="BnBalanceDot" Width="14" Height="14" Fill="{DynamicResource Fg}" Canvas.Top="4"/>
                                        </Canvas>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="limita a GPU" Foreground="{DynamicResource Faint}" FontSize="11"/>
                                        <TextBlock Text="equilibrado" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock Text="limita a CPU" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock x:Name="BnBalanceText" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    <TextBlock Text="Estimativa pelo desempenho relativo típico; o detector ao vivo mostra a realidade de cada jogo."
                                               Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Veredito ao vivo -->
                            <Border x:Name="BnLiveCard" Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock x:Name="BnLiveLabel" Text="AGORA" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="BnLiveTitle" Text="—" FontSize="24" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BnLiveGame" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="BnLiveAdvice" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Leituras ao vivo -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="18,16,18,6">
                            <StackPanel>
                                <TextBlock Text="LEITURAS AO VIVO" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="BnMeters" ItemTemplate="{StaticResource Meter}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,24,0"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Sessão -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="ANÁLISE DE SESSÃO" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Clique em iniciar, abra o jogo e jogue normalmente. Ao final você recebe o diagnóstico."
                                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel x:Name="BnDurationPanel" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BnDur" Content="1 min" Tag="1" Margin="0,0,6,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BnDur" Content="3 min" Tag="3" Margin="0,0,6,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BnDur" Content="5 min" Tag="5" Margin="0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnBnSession" Style="{StaticResource PrimaryButton}" Content="INICIAR ANÁLISE" Click="BtnBnSession_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="BnSessionStatus" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"/>
                                <StackPanel x:Name="BnResult" Visibility="Collapsed" Margin="0,16,0,0">
                                    <TextBlock x:Name="BnResultTitle" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BnResultSummary" Foreground="{DynamicResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="BnDistribution" ItemTemplate="{StaticResource Meter}"/>
                                    <TextBlock x:Name="BnResultAdvice" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== OVERLAY ===== -->
                <ScrollViewer x:Name="PageOverlay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Overlay" Style="{StaticResource H1}"/>
                            <TextBlock Text="FPS, frametime e sensores por cima do jogo" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel>
                                    <CheckBox x:Name="ChkOverlay" Content="Mostrar overlay" FontSize="15" Checked="ChkOverlay_Changed" Unchecked="ChkOverlay_Changed"/>
                                    <TextBlock Foreground="{DynamicResource Muted}" Margin="46,6,0,0" TextWrapping="Wrap">
                                        Atalho global: <Run Text="Ctrl + Shift + O" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Fg}"/> liga e desliga, inclusive dentro do jogo.
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <WrapPanel>
                                <StackPanel Margin="0,0,36,0">
                                    <TextBlock Text="POSIÇÃO" Style="{StaticResource Label}"/>
                                    <StackPanel x:Name="OvCornerPanel" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvCorner" Content="Superior esquerdo" Tag="TL" Margin="0,0,6,0" Checked="OvOption_Changed"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvCorner" Content="Superior direito" Tag="TR" Margin="0,0,6,0" Checked="OvOption_Changed"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvCorner" Content="Inferior esquerdo" Tag="BL" Margin="0,0,6,0" Checked="OvOption_Changed"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvCorner" Content="Inferior direito" Tag="BR" Margin="0" Checked="OvOption_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="TAMANHO" Style="{StaticResource Label}"/>
                                    <StackPanel x:Name="OvScalePanel" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvScale" Content="Pequeno" Tag="0.85" Margin="0,0,6,0" Checked="OvOption_Changed"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvScale" Content="Médio" Tag="1" Margin="0,0,6,0" Checked="OvOption_Changed"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="OvScale" Content="Grande" Tag="1.3" Margin="0" Checked="OvOption_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </WrapPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="O QUE MOSTRAR" Style="{StaticResource Label}"/>
                                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{StaticResource OutlineButton}" Content="SÓ FPS" Tag="min" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="OvPreset_Click"/>
                                        <Button Style="{StaticResource OutlineButton}" Content="PADRÃO" Tag="default" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="OvPreset_Click"/>
                                        <Button Style="{StaticResource OutlineButton}" Content="TUDO" Tag="all" Padding="10,4" FontSize="11" Click="OvPreset_Click"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                    Marque o que quer ver por cima do jogo; a mudança vale na hora e fica salva. Cada componente vira uma linha
                                    (GPU, VRAM, CPU, RAM) só com os itens escolhidos. Clock da memória, hotspot e ventoinha dependem da placa;
                                    o limitador (PerfCap) é só NVIDIA. Clock e temperatura da CPU precisam do app como administrador.
                                </TextBlock>
                                <StackPanel x:Name="OvItemsPanel"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="DETECÇÃO DE FPS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="OvStatus" FontSize="15"/>
                                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0">
                                    O FPS é medido pelo rastreamento de eventos do Windows (ETW), a mesma técnica do PresentMon:
                                    nada é injetado no jogo, então é seguro com anti-cheat. Funciona com DirectX 9 a 12; jogos em
                                    Vulkan/OpenGL só aparecem se o driver apresentar via DXGI. O overlay aparece em tela cheia
                                    "sem bordas" e na maioria dos jogos DX11/12 em tela cheia, mas não em tela cheia exclusiva antiga.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== RESET BENCH ===== -->
                <Grid x:Name="PageBench" Margin="36,30,36,30" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="RESET BENCH" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="BenchSub" Text="Benchmark de CPU por renderização 3D (path tracing), no mesmo princípio do Cinebench" Style="{StaticResource Sub}"/>
                    </StackPanel>

                    <!-- Seletor de teste -->
                    <WrapPanel x:Name="BenchTestPanel" Grid.Row="1" Margin="0,0,0,16">
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Render (CPU)" Tag="render" IsChecked="True" Checked="BenchTest_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Cena de jogo (GPU)" Tag="gpu" Checked="BenchTest_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Ray tracing (GPU)" Tag="rt" Checked="BenchTest_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Simulação de jogo (CPU)" Tag="sim" Checked="BenchTest_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Memória e carregamento" Tag="mem" Checked="BenchTest_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="BenchTest" Content="Disco" Tag="disk" Checked="BenchTest_Checked"/>
                    </WrapPanel>

                    <Grid x:Name="BenchPanelRender" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <!-- Render -->
                        <Border Style="{StaticResource CardBorder}" Padding="14" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Background="#050505">
                                    <Viewbox Stretch="Uniform">
                                        <Grid Width="960" Height="540">
                                            <Image x:Name="BenchImage" Width="960" Height="540" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Canvas x:Name="BenchBuckets" Width="960" Height="540"/>
                                            <TextBlock x:Name="BenchIdle" Text="Pressione INICIAR para renderizar a cena"
                                                       Foreground="{DynamicResource Faint}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                                <Grid Height="3" Margin="0,12,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="BenchProgress" ScaleX="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <TextBlock x:Name="BenchStatus" Text="Pronto" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="BenchElapsed" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Painel lateral -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="TESTE" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="BenchModePanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchMode" Content="Multi-core" Tag="mt"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchMode" Content="Single-core" Tag="st"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchMode" Content="Ambos" Tag="both" IsChecked="True"/>
                                        </WrapPanel>
                                        <TextBlock Text="DURAÇÃO" Style="{StaticResource Label}" Margin="0,10,0,8"/>
                                        <WrapPanel x:Name="BenchDurationPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchDur" Content="1 passada" Tag="0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="BenchDur" Content="Mínimo 10 min" Tag="10"/>
                                        </WrapPanel>
                                        <Button x:Name="BtnBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0" Click="BtnBench_Click"/>
                                        <TextBlock x:Name="BenchHint" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Style="{StaticResource Label}"/>
                                        <Grid>
                                            <TextBlock Text="Multi-core" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="BenchMt" Text="—" FontFamily="{StaticResource Mono}" FontSize="30"/>
                                                <TextBlock Text=" pts" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <TextBlock Text="Single-core" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="BenchSt" Text="—" FontFamily="{StaticResource Mono}" FontSize="30"/>
                                                <TextBlock Text=" pts" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="BenchRatio" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="DURANTE O TESTE" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="BenchLive">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}"/>
                                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="BenchHistoryEmpty" Text="Nenhum resultado ainda." Foreground="{DynamicResource Faint}"/>
                                        <ItemsControl x:Name="BenchHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Cena de jogo (GPU) ===== -->
                    <Grid x:Name="BenchPanelGpu" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="VALE · CENA DE JOGO" Style="{StaticResource Label}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}">
                                    Sobrevoo de um vale com terreno gerado por ruído fractal (~500 mil triângulos), 40 mil árvores
                                    por instancing, sombras em tempo real (mapa 4096² com bordas suaves), água com ondas, neblina,
                                    céu e pós-processamento HDR. A câmera segue um trajeto fixo pelo tempo e a resolução é fixa:
                                    o trabalho é o mesmo em qualquer PC. A cena abre numa janela própria; ESC cancela.
                                </TextBlock>
                                <Grid Margin="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="FPS AGORA" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="GbFpsNow" Text="—" FontFamily="{StaticResource Mono}" FontSize="44"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="GPU" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="GbGpuNow" Text="—" FontFamily="{StaticResource Mono}" FontSize="20" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Height="3" Margin="0,14,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="GbProgress" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="GbStatus" Text="Pronto" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESOLUÇÃO" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="GbResPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GbRes" Content="1080p" Tag="1920x1080" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GbRes" Content="1440p" Tag="2560x1440"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GbRes" Content="4K" Tag="3840x2160"/>
                                        </WrapPanel>
                                        <TextBlock Text="DURAÇÃO" Style="{StaticResource Label}" Margin="0,10,0,8"/>
                                        <WrapPanel x:Name="GbDurPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GbDur" Content="30 s" Tag="30"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GbDur" Content="60 s" Tag="60" IsChecked="True"/>
                                        </WrapPanel>
                                        <Button x:Name="BtnGpuBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0" Click="BtnGpuBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="GbResult" ItemTemplate="{StaticResource KeyValueRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="GbHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Ray tracing (GPU, DXR 1.1) ===== -->
                    <Grid x:Name="BenchPanelRt" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="24,20" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="CIDADE DE OBJETOS · RAY TRACING POR HARDWARE" Style="{StaticResource Label}"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}">
                                            Direct3D 12 com DXR 1.1: usa os núcleos de ray tracing da placa (RTX 20 ou mais nova, Radeon RX 6000
                                            ou mais nova, Intel Arc). 4 mil objetos em materiais fosco, metal e espelho; por pixel, path tracing com
                                            sombras suaves, oclusão de ambiente, reflexos de reflexos e iluminação indireta. A estrutura de
                                            aceleração é refeita a cada frame, com objetos girando, como nos jogos. Abre numa janela própria; ESC cancela.
                                        </TextBlock>
                                        <Grid Margin="0,22,0,0">
                                            <StackPanel>
                                                <TextBlock Text="FPS AGORA" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="RtFpsNow" Text="—" FontFamily="{StaticResource Mono}" FontSize="44"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="ETAPA" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="RtPhase" Text="—" FontFamily="{StaticResource Mono}" FontSize="20" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Height="3" Margin="0,14,0,8" Background="{DynamicResource Line}">
                                            <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform><ScaleTransform x:Name="RtProgress" ScaleX="0"/></Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="RtStatus" Text="Pronto" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="24,20">
                                    <StackPanel>
                                        <TextBlock Text="COMO COMPARAR COM CONFIANÇA" Style="{StaticResource Label}"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12">
                                            O teste aquece a placa sem medir (o clock e a temperatura se estabilizam) e depois roda 3 passadas
                                            iguais. A nota usa a MEDIANA das passadas, e a variação entre elas mostra se o resultado é
                                            confiável (abaixo de 3%). O tempo de cada frame vem do relógio da própria GPU. Compare só resultados
                                            com a mesma resolução e o mesmo preset, com o PC na tomada, sem outros programas pesados abertos
                                            e com o mesmo driver. A cena é sempre a mesma (sementes fixas), em qualquer PC.
                                        </TextBlock>
                                        <TextBlock Text="REFERÊNCIA MEDIDA" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12">
                                            AMD Radeon RX 9070 · Alta 1440p · modo Padrão: 878 pts (87,8 FPS, 1% low 77), variação 0,5%.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESOLUÇÃO" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="RtResPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtRes" Content="1080p" Tag="1920x1080"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtRes" Content="1440p" Tag="2560x1440" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtRes" Content="4K" Tag="3840x2160"/>
                                        </WrapPanel>
                                        <TextBlock Text="PRESET" Style="{StaticResource Label}" Margin="0,10,0,8"/>
                                        <WrapPanel x:Name="RtPresetPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtPreset" Content="Normal" Tag="normal"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtPreset" Content="Alta" Tag="alta" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtPreset" Content="Extrema" Tag="extrema"/>
                                        </WrapPanel>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                            Normal: 2 amostras e 2 rebatidas por pixel · Alta: 4 e 3 · Extrema: 8 e 4.
                                        </TextBlock>
                                        <TextBlock Text="MODO" Style="{StaticResource Label}" Margin="0,10,0,8"/>
                                        <WrapPanel x:Name="RtModePanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtMode" Content="Padrão" Tag="std" IsChecked="True"
                                                         ToolTip="Aquece 20 s e mede 3 passadas de 30 s (~2 min). Use para comparar."/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="RtMode" Content="Rápido" Tag="quick"
                                                         ToolTip="Aquece 5 s e mede 3 passadas de 10 s (~35 s). Só para uma ideia rápida."/>
                                        </WrapPanel>
                                        <Button x:Name="BtnRtBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0" Click="BtnRtBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="RtVerdict" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <ItemsControl x:Name="RtResult" ItemTemplate="{StaticResource KeyValueRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="RtHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Simulação de jogo (CPU) ===== -->
                    <Grid x:Name="BenchPanelSim" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" Padding="14" VerticalAlignment="Top">
                            <StackPanel>
                                <Grid>
                                    <Border Background="#050505" HorizontalAlignment="Center">
                                        <Image x:Name="SimImage" Width="440" Height="440" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <TextBlock x:Name="SimIdle" Text="30 mil unidades em batalha" Foreground="{DynamicResource Faint}" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Height="3" Margin="0,12,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="SimProgress" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <TextBlock x:Name="SimStatus" Text="Pronto" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="SimFpsNow" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
                                            Simula o trabalho de CPU de um jogo: a thread principal monta a grade espacial, roda a lógica
                                            e prepara o desenho; as outras threads calculam física, colisão e IA de 30 mil unidades.
                                            A nota é quantos frames por segundo a CPU aguenta.
                                        </TextBlock>
                                        <TextBlock Text="DURAÇÃO" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="SimDurPanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="SimDur" Content="20 s" Tag="20" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="SimDur" Content="60 s" Tag="60"/>
                                        </WrapPanel>
                                        <Button x:Name="BtnSimBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0" Click="BtnSimBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="SimResult" ItemTemplate="{StaticResource KeyValueRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="SimHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Memória e carregamento ===== -->
                    <Grid x:Name="BenchPanelMem" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="RESULTADOS" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="MemResult" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,2,140,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Height="3" Margin="0,16,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="MemProgress" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="MemStatus" Text="Pronto" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12">
                                            Mede a latência e a banda da RAM e simula o carregamento de um mapa: um pacote de 512 MB e
                                            mil arquivos de 64 KB, lidos do disco sem o cache do Windows. Os arquivos de teste ficam na
                                            pasta temporária e são apagados no final.
                                        </TextBlock>
                                        <Button x:Name="BtnMemBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Click="BtnMemBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="MemHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Disco ===== -->
                    <Grid x:Name="BenchPanelDisk" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="RESULTADOS" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="DiskResult" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,2,170,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Height="3" Margin="0,16,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="DiskProgress" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="DiskStatus" Text="Pronto" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="UNIDADE" Style="{StaticResource Label}"/>
                                        <WrapPanel x:Name="DiskDrivePanel"/>
                                        <TextBlock Text="TAMANHO DO TESTE" Style="{StaticResource Label}" Margin="0,10,0,8"/>
                                        <WrapPanel x:Name="DiskSizePanel">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DiskSize" Content="512 MB" Tag="512"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DiskSize" Content="1 GB" Tag="1024" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DiskSize" Content="4 GB" Tag="4096"/>
                                        </WrapPanel>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,12">
                                            Mede leitura e escrita sequenciais e acessos aleatórios de 4 KB, direto no disco (sem o cache do Windows).
                                            Grava um arquivo temporário na unidade escolhida e o apaga no final. Feche outros programas pesados antes.
                                        </TextBlock>
                                        <Button x:Name="BtnDiskBench" Style="{StaticResource PrimaryButton}" Content="INICIAR" Click="BtnDiskBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}"/>
                                        <ItemsControl x:Name="DiskHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ===== RESET OTIMIZA ===== -->
                <ScrollViewer x:Name="PageOptimize" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="RESET OTIMIZA" Style="{StaticResource H1}"/>
                            <TextBlock Text="Libera memória, fecha o que atrapalha e ajusta o Windows para jogos" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <!-- Botão principal -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <Grid>
                                        <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="OptRamText" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Height="6" Background="{DynamicResource Line}" Margin="0,0,0,12">
                                        <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="OptRamBar" ScaleX="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap">
                                        Um clique: limpa a memória em espera e fecha os programas marcados na lista abaixo.
                                        Use antes de abrir um jogo.
                                    </TextBlock>
                                    <TextBlock x:Name="OptResult" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnOptimize" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="RESET OTIMIZA"
                                        FontSize="16" Padding="34,16" VerticalAlignment="Center" Click="BtnOptimize_Click"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Programas -->
                            <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="PROGRAMAS PARA FECHAR" Style="{StaticResource Label}"/>
                                        <Button Style="{StaticResource OutlineButton}" Content="ATUALIZAR" Padding="10,4" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnRefreshApps_Click"/>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                                        Marcados = seguros de fechar durante o jogo. Programas com janela recebem o pedido de
                                        fechar (como clicar no X) e não são forçados, para não perder nada não salvo.
                                    </TextBlock>
                                    <ItemsControl x:Name="OptApps">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding MemoryText}" FontFamily="{StaticResource Mono}"
                                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Ajustes do Windows -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="AJUSTES DO WINDOWS PARA JOGOS" Style="{StaticResource Label}"/>
                                        <Button Style="{StaticResource OutlineButton}" Content="RESTAURAR ORIGINAIS" Padding="10,4" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnRestoreTweaks_Click"/>
                                    </Grid>
                                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                                        O interruptor mostra o estado atual e aplica na hora. O valor original é guardado na primeira
                                        alteração. Não mexemos em segurança (Defender, Integridade de Memória, UAC, Windows Update).
                                    </TextBlock>
                                    <ItemsControl x:Name="OptTweaks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsOn, Mode=OneWay}" Tag="{Binding}" Click="Tweak_Click"
                                                                  VerticalAlignment="Top" Margin="0,1,12,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,110,0"/>
                                                                <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding Effect}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== INICIALIZAÇÃO (programas que abrem com o Windows) ===== -->
                <ScrollViewer x:Name="PageStartup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,190,0">
                                <TextBlock Text="INICIALIZAÇÃO" Style="{StaticResource H1}"/>
                                <TextBlock Text="Programas que abrem junto com o Windows · desative ou remova o que não precisa" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="ATUALIZAR" Padding="20,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnStartupScan_Click"/>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="StartupSummary" Text="PROGRAMAS DE INICIALIZAÇÃO" Style="{StaticResource Label}"/>
                                    <Button x:Name="BtnStartupRestore" Style="{StaticResource OutlineButton}" Content="RESTAURAR REMOVIDOS" Padding="10,4" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnStartupRestore_Click"/>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                                    O interruptor ativa ou desativa na hora, do mesmo jeito que o Gerenciador de Tarefas (a entrada continua
                                    lá e pode ser religada). REMOVER apaga a entrada da inicialização; o programa continua instalado e
                                    dá para desfazer em "Restaurar removidos". Vale na próxima vez que o Windows iniciar.
                                </TextBlock>
                                <ItemsControl x:Name="StartupList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="StartupToggle_Click"
                                                              VerticalAlignment="Top" Margin="0,1,12,0" ToolTip="Ativar / desativar na inicialização"/>
                                                    <StackPanel Grid.Column="1">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,150,0"/>
                                                            <TextBlock Text="{Binding State}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Command}" Foreground="{DynamicResource Faint}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Command}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Faint}" FontSize="10.5" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="REMOVER" Padding="12,5" FontSize="11"
                                                            Tag="{Binding}" Click="StartupRemove_Click" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="StartupResult" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== INSTALAR APPS (pós-formatação, via winget) ===== -->
                <ScrollViewer x:Name="PageApps" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,250,0">
                                <TextBlock Text="INSTALAR APPS" Style="{StaticResource H1}"/>
                                <TextBlock Text="Os essenciais depois de formatar o PC · versão oficial mais recente, instalação silenciosa" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnAppsInstall" Style="{StaticResource PrimaryButton}" Content="INSTALAR SELECIONADOS" Padding="20,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnAppsInstall_Click"/>
                        </Grid>
                        <Grid Height="3" Margin="0,0,0,8" Background="{DynamicResource Line}">
                            <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="AppsProgress" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="AppsStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="APPS" Style="{StaticResource Label}"/>
                                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{StaticResource OutlineButton}" Content="MARCAR TODOS" Padding="10,4" FontSize="11" Margin="0,0,8,0" Click="BtnAppsAll_Click"/>
                                        <Button Style="{StaticResource OutlineButton}" Content="DESMARCAR" Padding="10,4" FontSize="11" Click="BtnAppsNone_Click"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                                    Usa o winget, o instalador de pacotes da Microsoft que já vem no Windows 10/11: baixa do site oficial de
                                    cada fabricante e confere o arquivo antes de instalar. Os apps são instalados um de cada vez, sem janelas.
                                    O que já está instalado aparece marcado como INSTALADO.
                                </TextBlock>
                                <ItemsControl x:Name="AppsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                               VerticalAlignment="Top" Margin="14,3,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value=""/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Installed}" Value="True">
                                                                        <Setter Property="Text" Value="INSTALADO"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="BtnAppsStore" Style="{StaticResource OutlineButton}" Content="ATUALIZAR O INSTALADOR DE APLICATIVO (MICROSOFT STORE)"
                                        Padding="14,7" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed" Click="BtnAppsStore_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== RESET MAKER · Portas COM (fantasmas e números COM presos) ===== -->
                <ScrollViewer x:Name="PageMakerPorts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="PORTAS COM" Style="{StaticResource H1}"/>
                            <TextBlock Text="Arduino, ESP32 e conversores seriais · remova dispositivos fantasmas e libere números COM presos" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="USB E PORTAS COM (ARDUINO, ESP32, CONVERSORES SERIAIS)" Style="{StaticResource Label}"/>
                                    <Button Style="{StaticResource OutlineButton}" Content="PROCURAR" Padding="10,4" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnUsbScan_Click"/>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12">
                                    Cada placa plugada numa porta USB diferente vira um registro novo e prende um número COM. Os registros
                                    de dispositivos que não estão conectados ("fantasmas") confundem a IDE do Arduino e empurram a porta
                                    para COM20+. Remover um fantasma é seguro: ao plugar de novo, o Windows reinstala na hora.
                                </TextBlock>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CONECTADOS AGORA" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="UsbConnected" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="NÚMEROS COM RESERVADOS" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="UsbComDb" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="UsbSummary" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="UsbList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding InstanceId}" Foreground="{DynamicResource Faint}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="BtnUsbRemove" Style="{StaticResource PrimaryButton}" Content="REMOVER SELECIONADOS"
                                            Padding="18,9" Margin="0,0,10,8" Click="BtnUsbRemove_Click"/>
                                    <Button Style="{StaticResource OutlineButton}" Content="LIBERAR NÚMEROS COM PRESOS"
                                            Padding="18,9" Margin="0,0,10,8" Click="BtnComDb_Click"/>
                                    <Button x:Name="BtnComDbRestore" Style="{StaticResource OutlineButton}" Content="DESFAZER LIBERAÇÃO"
                                            Padding="18,9" Margin="0,0,10,8" Click="BtnComDbRestore_Click"/>
                                    <CheckBox x:Name="UsbShowAll" Content="Mostrar todos os ausentes (não só portas COM e placas)"
                                              VerticalAlignment="Center" Margin="6,0,0,8" Checked="UsbShowAll_Changed" Unchecked="UsbShowAll_Changed"/>
                                </WrapPanel>
                                <TextBlock x:Name="UsbResult" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== RESET MAKER · Drivers seriais (CH340, CP210x, FTDI, Prolific, Arduino) ===== -->
                <ScrollViewer x:Name="PageMakerDrv" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,190,0">
                                <TextBlock Text="DRIVERS SERIAIS" Style="{StaticResource H1}"/>
                                <TextBlock Text="CH340 · CP2102/CP210x · FTDI · Prolific · Arduino — diagnóstico, reinstalação e troca de versão do driver" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnMakerScan" Style="{StaticResource PrimaryButton}" Content="VERIFICAR" Padding="20,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnMakerScan_Click"/>
                        </Grid>
                        <TextBlock x:Name="MakerStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Conectados agora -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="PLACAS E CONVERSORES CONECTADOS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="MakerNoDevices" Text="Nenhuma placa ou conversor serial conectado. Plugue a placa e clique em VERIFICAR."
                                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <ItemsControl x:Name="MakerDevices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/>
                                                            <TextBlock Text="{Binding State}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,1,0,0">
                                                            <Run Text="Driver: "/><Run Text="{Binding Driver, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Advice}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top">
                                                        <Button Style="{StaticResource OutlineButton}" Content="REINSTALAR" Padding="12,5" FontSize="11" Margin="0,0,0,6"
                                                                Tag="{Binding}" Click="MakerReinstall_Click"/>
                                                        <Button Style="{StaticResource OutlineButton}" Content="PÁGINA OFICIAL" Padding="12,5" FontSize="11"
                                                                Tag="{Binding Chip}" Click="MakerOfficial_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0">
                                    REINSTALAR remove o dispositivo e pede ao Windows para detectar de novo, com o melhor driver disponível
                                    (resolve a maioria dos códigos 10 e 43). Placa que não aparece nenhuma vez: troque o cabo, muitos são só de carga.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Drivers oficiais embutidos no app -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="DRIVERS INCLUÍDOS" Style="{StaticResource Label}"/>
                                    <Button x:Name="BtnMakerBundleAll" Style="{StaticResource OutlineButton}" Content="INSTALAR TODOS" Padding="10,4" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnMakerBundleAll_Click"/>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                                    Drivers oficiais de cada fabricante que já vêm dentro do RESET EXPLODE: instalam sem internet, ideal logo depois
                                    de formatar. Pode instalar com a placa desconectada; o Windows usa o driver quando ela for plugada.
                                    Os drivers Arduino são assinados pela Arduino (não pela Microsoft): o Windows pode pedir confirmação.
                                </TextBlock>
                                <ItemsControl x:Name="MakerBundled">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,100,0"/>
                                                            <TextBlock Text="{Binding State}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="INSTALAR" Padding="12,5" FontSize="11"
                                                            Tag="{Binding}" Click="MakerInstallBundled_Click" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Pacotes de driver -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="DRIVERS INSTALADOS NO WINDOWS" Style="{StaticResource Label}"/>
                                    <Button x:Name="BtnMakerRestore" Style="{StaticResource OutlineButton}" Content="RESTAURAR REMOVIDOS" Padding="10,4" FontSize="11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnMakerRestore_Click"/>
                                </Grid>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                                    Versões guardadas no Windows para cada chip, da mais nova para a mais antiga. Quando a versão nova não funciona
                                    com a sua placa (clones de CH340, FTDI ou PL2303 falsificados), remova-a: o Windows passa a usar a anterior.
                                    Para desinstalar o driver de vez, remova todas as versões daquele chip. Cada remoção faz backup antes.
                                </TextBlock>
                                <TextBlock x:Name="MakerNoPackages" Text="Nenhum driver de chip serial instalado além dos do próprio Windows."
                                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <ItemsControl x:Name="MakerPackages">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="REMOVER" Padding="12,5" FontSize="11"
                                                            Tag="{Binding}" Click="MakerRemovePackage_Click" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Arduino IDE -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="ARDUINO IDE" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="MakerIde" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock x:Name="MakerHolders" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="BtnMakerIde" Style="{StaticResource OutlineButton}" Content="INSTALAR / ATUALIZAR A IDE"
                                            Padding="18,9" Margin="0,0,10,8" Click="BtnMakerIde_Click"/>
                                    <Button Style="{StaticResource OutlineButton}" Content="FECHAR PROGRAMAS QUE PRENDEM A PORTA"
                                            Padding="18,9" Margin="0,0,10,8" Click="BtnMakerHolders_Click"/>
                                    <Button Style="{StaticResource OutlineButton}" Content="LIMPAR CACHE DA IDE"
                                            Padding="18,9" Margin="0,0,10,8" Click="BtnMakerCache_Click"/>
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap">
                                    "Porta ocupada" / "Access denied" no upload: outro programa está com a porta aberta (monitor serial,
                                    Cura, PuTTY...). IDE travada em "Downloading index" ou erro ao instalar placas: limpe o cache (as placas e
                                    bibliotecas instaladas continuam). A instalação da IDE também instala os drivers das placas Arduino oficiais.
                                </TextBlock>
                                <TextBlock x:Name="MakerIdeResult" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== RESET OC ===== -->
                <ScrollViewer x:Name="PageOc" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="RESET OC" Style="{StaticResource H1}"/>
                            <TextBlock Text="Ajustes da GPU, verificador de estabilidade e guia de overclock na BIOS" Style="{StaticResource Sub}"/>
                        </StackPanel>

                        <!-- GPU: limite de energia e teto de clock -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="OcGpuTitle" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="OcGpuState" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <Grid>
                                    <TextBlock Text="LIMITE DE ENERGIA" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="OcPowerValue" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="OcPower" Minimum="175" Maximum="300" Value="250" TickFrequency="5"
                                        IsSnapToTickEnabled="True" ValueChanged="OcPower_Changed"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,16">
                                    Mais energia = clocks mais altos sustentados (e mais calor). Menos energia = PC mais frio e silencioso.
                                </TextBlock>

                                <TextBlock Text="TETO DE CLOCK (UNDERVOLT)" Style="{StaticResource Label}"/>
                                <WrapPanel x:Name="OcClockPanel" Margin="0,4,0,0"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,16">
                                    Limitar o clock máximo faz a placa usar menos tensão: costuma perder 1–3% de FPS e economizar bastante
                                    energia e calor. "Sem teto" é o comportamento normal.
                                </TextBlock>

                                <WrapPanel>
                                    <Button x:Name="BtnOcApply" Style="{StaticResource PrimaryButton}" Content="APLICAR"
                                            Padding="20,9" Margin="0,0,10,8" Click="BtnOcApply_Click"/>
                                    <Button Style="{StaticResource OutlineButton}" Content="RESTAURAR PADRÃO"
                                            Padding="20,9" Margin="0,0,10,8" Click="BtnOcReset_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="OcGpuResult" TextWrapping="Wrap"/>
                                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                    Ajustes temporários: voltam ao padrão ao reiniciar o PC. Usa só os controles oficiais do driver NVIDIA (NVML);
                                    offset de clock/memória não é liberado por essa via no Windows.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Verificador de estabilidade -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="VERIFICADOR DE ESTABILIDADE" Style="{StaticResource Label}"/>
                                <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12">
                                    Depois de mudar algo (aqui ou na BIOS): mede a nota, roda stress, vigia temperatura e procura erros de
                                    hardware (WHEA) e reinícios do driver de vídeo no registro do Windows.
                                </TextBlock>

                                <TextBlock Text="CONFIGURAÇÃO TESTADA" Style="{StaticResource Label}"/>
                                <TextBox x:Name="OcLabel" Tag="ex.: PBO + Curve Optimizer -15, GPU 220 W" Margin="0,0,0,12"/>

                                <WrapPanel>
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock Text="TESTAR" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="OcTargetPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcTarget" Content="CPU + RAM" Tag="cpu" Margin="0,0,6,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcTarget" Content="GPU" Tag="gpu" Margin="0,0,6,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcTarget" Content="Ambos" Tag="both" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="DURAÇÃO" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="OcDurPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcDur" Content="5 min" Tag="5" Margin="0,0,6,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcDur" Content="15 min" Tag="15" Margin="0,0,6,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="OcDur" Content="30 min" Tag="30" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>

                                <Button x:Name="BtnOcCheck" Style="{StaticResource PrimaryButton}" Content="INICIAR VERIFICAÇÃO"
                                        HorizontalAlignment="Left" Padding="24,10" Margin="0,14,0,0" Click="BtnOcCheck_Click"/>

                                <Grid Height="4" Margin="0,12,0,8" Background="{DynamicResource Line}">
                                    <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="OcProgress" ScaleX="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="OcStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>

                                <Border x:Name="OcVerdictCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource LineStrong}"
                                        BorderThickness="1" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="OcVerdict" FontSize="22" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="OcVerdictWhy" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                        <ItemsControl x:Name="OcResult">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" Opacity="0.7" Margin="0,0,16,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Mono}"
                                                                   HorizontalAlignment="Right" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="ERROS DE HARDWARE RECENTES" Style="{StaticResource Label}" Margin="0,16,0,4"/>
                                <TextBlock x:Name="OcRecentErrors" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>

                                <TextBlock Text="HISTÓRICO" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                                <ItemsControl x:Name="OcHistory" ItemTemplate="{StaticResource Meter}"/>
                            </StackPanel>
                        </Border>

                        <!-- Guia de overclock na BIOS -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="OcGuideTitle" Text="GUIA: OVERCLOCK NA BIOS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="OcGuideIntro" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="OcGuide">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                                        VerticalAlignment="Top" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Number}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Where}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== STRESS TEST ===== -->
                <Grid x:Name="PageStress" Margin="36,30,36,30" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="140"/>
                        <RowDefinition Height="110"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Stress test" Style="{StaticResource H1}"/>
                        <TextBlock Text="Carga máxima com corte automático por temperatura" Style="{StaticResource Sub}"/>
                    </StackPanel>

                    <!-- Configuração -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Linha 1: geral + CPU/RAM -->
                            <WrapPanel>
                                <StackPanel Margin="0,0,36,0">
                                    <TextBlock Text="COMPONENTES" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal" Height="30">
                                        <CheckBox x:Name="ChkCpu" Content="CPU" IsChecked="True" Margin="0,0,20,0"/>
                                        <CheckBox x:Name="ChkRam" Content="RAM" Checked="ChkRam_Click" Unchecked="ChkRam_Click" Margin="0,0,20,0"/>
                                        <CheckBox x:Name="ChkGpu" Content="GPU" Checked="ChkGpu_Click" Unchecked="ChkGpu_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,36,0">
                                    <TextBlock Text="USO DA RAM LIVRE" Style="{StaticResource Label}"/>
                                    <StackPanel x:Name="RamFractionPanel" Orientation="Horizontal" IsEnabled="False">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="Ram" Content="40%" Tag="0.4" Margin="0,0,6,0"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="Ram" Content="60%" Tag="0.6" Margin="0,0,6,0" IsChecked="True"/>
                                        <RadioButton Style="{StaticResource Chip}" GroupName="Ram" Content="80%" Tag="0.8" Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="LIMITE CPU °C" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="TempLimit" Text="90" Width="80"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="LIMITE GPU °C" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="GpuTempLimit" Text="85" Width="80" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="DURAÇÃO (MIN)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="TxtDuration" Text="10" Width="80" Tag="0 = ∞"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Linha 2: GPU (estilo FurMark) -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                                <WrapPanel x:Name="GpuOptions" IsEnabled="False">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="GPU · RESOLUÇÃO" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="GpuResPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuRes" Content="720p" Tag="1280x720" Margin="0,0,6,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuRes" Content="1080p" Tag="1920x1080" Margin="0,0,6,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuRes" Content="1440p" Tag="2560x1440" Margin="0,0,6,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuRes" Content="Tela cheia" Tag="full" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="ANTI-ALIASING" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="GpuMsaaPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuMsaa" Content="Off" Tag="1" Margin="0,0,6,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuMsaa" Content="4x MSAA" Tag="4" Margin="0,0,6,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuMsaa" Content="8x MSAA" Tag="8" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="INTENSIDADE" Style="{StaticResource Label}"/>
                                        <StackPanel x:Name="GpuIntensityPanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuInt" Content="Normal" Tag="96,32" Margin="0,0,6,0"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuInt" Content="Alta" Tag="128,48" Margin="0,0,6,0" IsChecked="True"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="GpuInt" Content="Extrema" Tag="160,64" Margin="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Button x:Name="BtnStress" Style="{StaticResource PrimaryButton}" Content="INICIAR"
                                        MinWidth="150" Click="BtnStress_Click"/>
                                <TextBlock x:Name="StressHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12"
                                           MaxWidth="220" Margin="0,10,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Leituras -->
                    <UniformGrid Grid.Row="2" Columns="8" Margin="-4,0,-4,14">
                        <UniformGrid.Resources>
                            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                <Setter Property="Margin" Value="4,0"/>
                                <Setter Property="Padding" Value="14"/>
                            </Style>
                            <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Big}">
                                <Setter Property="FontSize" Value="18"/>
                            </Style>
                            <Style x:Key="StatSub" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Margin" Value="0,4,0,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </UniformGrid.Resources>
                        <Border x:Name="StatusCard">
                            <StackPanel>
                                <TextBlock x:Name="StStatusLabel" Text="STATUS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StStatus" Text="Parado" Style="{StaticResource StatValue}" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="TEMPO" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StElapsed" Text="00:00:00" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="TEMP. CPU" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StTemp" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="StTempMax" Text="máx. —" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="CONSUMO CPU" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StPower" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="StLoad" Text="carga —" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="TEMP. GPU" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StGpuTemp" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="StGpuTempMax" Text="máx. —" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="CONSUMO GPU" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StGpuPower" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="StGpuCap" Text="—" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="FPS (GPU)" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StFps" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="StFpsAvg" Text="média —" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="RAM" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="StRam" Text="—" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="passes / erros" Style="{StaticResource StatSub}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Gráfico -->
                    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="18,14,18,12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="TEMPERATURAS — ÚLTIMOS 5 MIN" Style="{StaticResource Label}" Margin="0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Rectangle Width="14" Height="2" Fill="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="CPU" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                                    <Rectangle Width="14" Height="2" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="GPU" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                                    <Line X1="0" X2="14" Stroke="{DynamicResource Muted}" StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="limites" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <Canvas x:Name="TempChart" ClipToBounds="True" SizeChanged="TempChart_SizeChanged"/>
                        </DockPanel>
                    </Border>

                    <!-- Log -->
                    <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="18,14,10,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="REGISTRO" Style="{StaticResource Label}"/>
                            <ListBox x:Name="StressLog" FontFamily="{StaticResource Mono}" FontSize="12"
                                     Foreground="{DynamicResource Muted}" ItemContainerStyle="{StaticResource PlainItem}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
