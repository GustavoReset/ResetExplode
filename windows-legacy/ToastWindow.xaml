<Window x:Class="ResetExplode.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RESET EXPLODE aviso" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Opacity="0">
    <Border Background="#F2080808" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Padding="16,12" Width="340">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" Background="#F5F5F5" CornerRadius="3" VerticalAlignment="Top" Margin="0,2,14,0">
                <TextBlock x:Name="TIcon" Text="&#xE88E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                           Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TTitle" Foreground="#F5F5F5" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="TText" Foreground="#9A9A9A" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                <TextBlock Text="RESET EXPLODE" Foreground="#4A4A4A" FontSize="9.5" FontWeight="Bold" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
