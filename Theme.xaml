<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FortKnox.UI">

    <!-- Marca (degradês, símbolo e logotipo vetoriais) -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brand.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Paleta Fort Knox (identidade v3): base preto + grafite, ouro em foco, vermelho nos detalhes =====
         Valores do modo escuro; ThemeManager troca para o claro em tempo real (DynamicResource). -->
    <SolidColorBrush x:Key="Bg" Color="#0B0C0E"/>
    <SolidColorBrush x:Key="Panel" Color="#111316"/>
    <SolidColorBrush x:Key="Card" Color="#17191D"/>
    <SolidColorBrush x:Key="Hover" Color="#22252B"/>
    <SolidColorBrush x:Key="Line" Color="#262A31"/>
    <SolidColorBrush x:Key="LineStrong" Color="#3A3F47"/>
    <SolidColorBrush x:Key="Fg" Color="#F6F5F1"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA0A9"/>
    <SolidColorBrush x:Key="Faint" Color="#5E646D"/>
    <SolidColorBrush x:Key="Ink" Color="#0B0C0E"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#2E333A"/>
    <SolidColorBrush x:Key="ThumbHover" Color="#5A616B"/>
    <SolidColorBrush x:Key="ThumbDrag" Color="#D4A13A"/>
    <!-- Ouro Reserva (cor da marca), Ouro Claro (texto/realce sobre escuro), fundo dourado sutil e Vermelho Comando -->
    <SolidColorBrush x:Key="Accent" Color="#D4A13A"/>
    <SolidColorBrush x:Key="AccentText" Color="#F0C766"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2A2414"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0B0C0E"/>
    <SolidColorBrush x:Key="Danger" Color="#D7263D"/>
    <SolidColorBrush x:Key="Ok" Color="#2EBD6B"/>
    <SolidColorBrush x:Key="Warn" Color="#F29D38"/>
    <!-- Fundos em degradê: janela (radial grafite) e cartões -->
    <RadialGradientBrush x:Key="WindowBg" Center="0.25,0" GradientOrigin="0.25,0" RadiusX="1.1" RadiusY="1.3">
        <GradientStop Offset="0" Color="#1D2025"/><GradientStop Offset="0.55" Color="#111316"/><GradientStop Offset="1" Color="#0B0C0E"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1B1E23"/><GradientStop Offset="1" Color="#15171A"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#16181C"/><GradientStop Offset="1" Color="#0F1013"/>
    </LinearGradientBrush>

    <!-- Tipografia da marca, embutida no .exe: Michroma (marca e títulos), Inter (texto), JetBrains Mono (dados) -->
    <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Michroma</FontFamily>
    <FontFamily x:Key="Text">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="Mono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Canto entre as barras de rolagem e afins -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0B0C0E"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#22252B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#22252B"/>

    <!-- ===== Tipografia ===== -->
    <!-- Título de página: Michroma (peso único; nunca negrito), caixa alta -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <!-- Rótulo técnico: JetBrains Mono, espaçado, em ouro -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    </Style>

    <!-- ===== Cartão ===== -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <!-- Cartão da marca: canto chanfrado a 45° (Brandbook v3). Use com ui:ChamferBorder. -->
    <Style x:Key="Card" TargetType="ui:ChamferBorder">
        <Setter Property="Background" Value="{DynamicResource CardFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cut" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- ===== Botões ===== -->
    <!-- Ação principal: degradê ouro com texto preto (o "lingote") -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GoldButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="BorderBrush" Value="#F7D98A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="28,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ui:ChamferBorder x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Cut="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                    </ui:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ação secundária: contorno ouro -->
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ação destrutiva (apagar, remover): vermelho Comando -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource RedGradient}"/>
        <Setter Property="Foreground" Value="#F6F5F1"/>
        <Setter Property="BorderBrush" Value="#F0475A"/>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Danger}"/>
                            <Setter Property="Foreground" Value="#F6F5F1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navegação lateral ===== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="Margin" Value="10,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Item selecionado: fundo dourado sutil, texto em ouro e barra de ouro à esquerda (a "muralha") -->
                    <Grid>
                        <ui:ChamferBorder x:Name="bg" Background="Transparent" Height="36" Cut="6">
                            <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center"/>
                        </ui:ChamferBorder>
                        <Border x:Name="bar" Width="3" Height="18" HorizontalAlignment="Left" Margin="0,0,0,0"
                                Background="{StaticResource GoldMetal}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Título de categoria no menu lateral -->
    <Style x:Key="NavHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="Margin" Value="26,18,0,6"/>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <!-- Categoria recolhível do menu lateral: clica e mostra/esconde as sub-abas -->
    <!-- Módulo (SENTINELA, FORJA, ARENA...): nome em Michroma, recolhível -->
    <Style x:Key="NavGroup" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="10,6,10,1"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <ui:ChamferBorder x:Name="bg" Background="Transparent" Height="34" Cut="6">
                        <DockPanel Margin="14,0,12,0">
                            <TextBlock x:Name="chev" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10"
                                       VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform Angle="-90"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </ui:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            <Setter TargetName="chev" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Número grande de cartão (como os valores em destaque da referência) -->
    <Style x:Key="Hero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource GoldMetal}"/>
    </Style>

    <!-- ===== Abas superiores (na barra de título) ===== -->
    <Style x:Key="TopTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="bg" Background="Transparent" Height="44">
                        <ContentPresenter Margin="16,0" VerticalAlignment="Center"/>
                        <Rectangle x:Name="line" Height="2" VerticalAlignment="Bottom" Margin="16,0" Fill="{StaticResource GoldMetal}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            <Setter TargetName="line" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Chips (filtros / opções) ===== -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <ui:ChamferBorder x:Name="b" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Cut="6"
                            Padding="13,5" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </ui:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource GoldButton}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox como interruptor ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="root" Orientation="Horizontal" Background="Transparent">
                        <ui:ChamferBorder x:Name="track" Width="36" Height="20" BorderThickness="1" Cut="5"
                                BorderBrush="{DynamicResource LineStrong}" Background="Transparent" VerticalAlignment="Center">
                            <Rectangle x:Name="knob" Width="11" Height="11" Margin="3,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Fill="{DynamicResource Muted}"/>
                        </ui:ChamferBorder>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource GoldButton}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource OnAccent}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TextBox (Tag = placeholder) ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
        <Setter Property="SelectionBrush" Value="#D4A13A"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ui:ChamferBorder x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Cut="6">
                        <Grid>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Faint}"
                                       Margin="{TemplateBinding Padding}" Padding="2,0,0,0" Visibility="Collapsed"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Grid>
                    </ui:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== PasswordBox (mesmo visual do TextBox) ===== -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
        <Setter Property="SelectionBrush" Value="#D4A13A"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <ui:ChamferBorder x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Cut="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </ui:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barras de rolagem finas ===== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="{DynamicResource ThumbBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbDrag}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="1">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== ListBox ===== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="PlainItem" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter Margin="0,2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListNavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="14,10" Margin="0,0,0,2"
                            BorderThickness="2,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== DataGrid ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="MinRowHeight" Value="32"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,0,12,10" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Bottom"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Panel}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider (monocromático) ===== -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" Background="{StaticResource GoldGradient}" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource GoldMetal}" BorderBrush="{DynamicResource Bg}" BorderThickness="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <Border Height="4" Background="{DynamicResource Line}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEmpty}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Cartão com selo de veredito, motivos e métricas (Energia, Rede) -->
    <DataTemplate x:Key="CardTemplate">
        <ui:ChamferBorder Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <StackPanel Margin="0,0,130,0">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ChamferBorder HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Cut="4" Padding="12,4">
                        <ui:ChamferBorder.Style>
                            <Style TargetType="ui:ChamferBorder">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Danger}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:ChamferBorder.Style>
                        <TextBlock Text="{Binding VerdictText}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                            <Setter Property="Foreground" Value="#F6F5F1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ui:ChamferBorder>
                </Grid>
                <TextBlock Text="{Binding Reasons}" TextWrapping="Wrap" Margin="0,12,0,12"/>
                <ItemsControl ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8,16,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:ChamferBorder>
    </DataTemplate>

</ResourceDictionary>
