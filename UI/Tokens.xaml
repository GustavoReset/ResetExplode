<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- ===== Design System Fort Knox · tokens (Brandbook v3, fortknox-tokens.json) =====
         Cores-base continuam em Theme.xaml e são trocadas por ThemeManager (claro/escuro).
         Aqui ficam os tokens que faltavam: cores de status com fundo suave, Azul Sinal, espaçamento, raios e escala de tipo.
         Valores do modo escuro; ThemeManager.Apply substitui os pincéis no claro. -->

    <!-- Status: cor cheia (texto, ícone, borda) + fundo suave (selo, linha destacada) -->
    <SolidColorBrush x:Key="Info" Color="#3E8BFF"/>
    <SolidColorBrush x:Key="InfoSoft" Color="#12203A"/>
    <SolidColorBrush x:Key="OkSoft" Color="#10281B"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#2E2112"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#2E1217"/>
    <!-- Véu atrás de modais -->
    <SolidColorBrush x:Key="Scrim" Color="#B30B0C0E"/>

    <!-- Espaçamento (grade de 4 px) -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">20</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,24</Thickness>

    <!-- Raios: controle 6, cartão 10, selo 4 -->
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">4</CornerRadius>

    <!-- Escala de tipo (px): Michroma só em títulos; Inter no texto; JetBrains Mono em dados e rótulos -->
    <sys:Double x:Key="TypeDisplay">21</sys:Double>
    <sys:Double x:Key="TypeTitle">16</sys:Double>
    <sys:Double x:Key="TypeBody">13</sys:Double>
    <sys:Double x:Key="TypeCaption">12</sys:Double>
    <sys:Double x:Key="TypeLabel">10.5</sys:Double>
    <sys:Double x:Key="TypeData">22</sys:Double>

    <!-- Movimento: curto e funcional; ThemeAnimations=false (Windows "Efeitos de animação" desligado) zera tudo -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionBase">0:0:0.2</Duration>
</ResourceDictionary>
