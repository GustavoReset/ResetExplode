<Window x:Class="FortKnox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FortKnox"
        Title="Fort Knox" Icon="Assets/app.ico" Width="1320" Height="840" MinWidth="1120" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource Text}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Border x:Name="Root" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Barra de título (marca + página atual + botões da janela) ===== -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <!-- Assinatura da marca: símbolo Bastião + logotipo FORT ⬟ KNOX (vetores de Brand.xaml) -->
                <Image x:Name="TitleLogo" Source="{StaticResource BrandSymbol}" Width="22" Height="23" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Image Source="{StaticResource BrandWordmark}" Height="11" VerticalAlignment="Center" Margin="0,1,0,0"/>
                <Border Width="1" Height="16" Background="{DynamicResource LineStrong}" Margin="18,0,16,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitlePage" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnSettings" Style="{StaticResource CaptionButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Configurações" AutomationProperties.Name="Configurações"/>
                <Button x:Name="BtnTheme" Style="{StaticResource CaptionButton}" Content="&#xE706;" Click="Theme_Click" ToolTip="Modo claro"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimizar"/>
                <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maximizar"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fechar"/>
            </StackPanel>

            <!-- ===== Menu lateral por categorias (painel arredondado, sempre visível) ===== -->
            <Border x:Name="Sidebar" Grid.Row="1" Margin="14,0,0,14" Background="{DynamicResource PanelFill}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <!-- Rodapé: aviso de sensores + leitura ao vivo compacta -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,6,16,16">
                        <Border x:Name="CpuSensorWarn" Visibility="Collapsed" BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Sem temperatura e consumo da CPU" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CpuSensorWarnText" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="CORRIGIR" Padding="10,5" FontSize="11"
                                        Click="BtnFixCpuSensors_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="CPU" Foreground="{DynamicResource AccentText}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Bold" Margin="0,3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideTemp" Grid.Column="1" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                                <TextBlock x:Name="SideLoad" Grid.Column="2" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Text="GPU" Foreground="{DynamicResource AccentText}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Bold" Margin="0,3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideGpuTemp" Grid.Row="1" Grid.Column="1" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                                <TextBlock x:Name="SideGpuLoad" Grid.Row="1" Grid.Column="2" Text="—" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Text="TESTE" Foreground="{DynamicResource AccentText}" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Bold" Margin="0,3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideStress" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="parado" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            </Grid>
                        </Border>
                        <DockPanel Margin="4,12,2,0">
                            <Image Source="{StaticResource BrandSymbol}" Width="12" Height="12.5" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.85"/>
                            <TextBlock x:Name="SideVersion" Text="v0.16" Foreground="{DynamicResource Faint}" FontFamily="{StaticResource Mono}" FontSize="10.5" VerticalAlignment="Center"/>
                            <TextBlock Text="OFFLINE" HorizontalAlignment="Right" Foreground="{DynamicResource Faint}" FontFamily="{StaticResource Mono}" FontSize="10" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Navegação por categorias -->
                    <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                        <StackPanel Margin="0,0,0,10">
                            <RadioButton x:Name="NavDash" Style="{StaticResource NavItem}" Tag="PageDash" Checked="Nav_Checked" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Painel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <Border Height="1" Background="{DynamicResource Line}" Margin="22,10,22,6"/>
                            <ToggleButton x:Name="GrpExplode" Style="{StaticResource NavGroup}" Content="SENTINELA"/>
                            <StackPanel x:Name="GrpExplodeItems" Margin="10,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpExplode, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" Tag="PageSystem" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sistema" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSensors" Style="{StaticResource NavItem}" Tag="PageSensors" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sensores" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavGpu" Style="{StaticResource NavItem}" Tag="PageGpu" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Placa de vídeo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDisks" Style="{StaticResource NavItem}" Tag="PageDisks" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Discos" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavEnergy" Style="{StaticResource NavItem}" Tag="PageEnergy" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Energia" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpPerf" Style="{StaticResource NavGroup}" Content="FORJA"/>
                            <StackPanel x:Name="GrpPerfItems" Margin="10,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpPerf, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavBench" Style="{StaticResource NavItem}" Tag="PageBench" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Benchmark" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavStress" Style="{StaticResource NavItem}" Tag="PageStress" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stress test" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavOc" Style="{StaticResource NavItem}" Tag="PageOc" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Overclock" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpGames" Style="{StaticResource NavGroup}" Content="ARENA"/>
                            <StackPanel x:Name="GrpGamesItems" Margin="10,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpGames, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavLauncher" Style="{StaticResource NavItem}" Tag="PageLauncher" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Biblioteca" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavGames" Style="{StaticResource NavItem}" Tag="PageGames" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC49;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="FPS estimado" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavBottleneck" Style="{StaticResource NavItem}" Tag="PageBottleneck" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Gargalo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpTools" Style="{StaticResource NavGroup}" Content="ARSENAL"/>
                            <StackPanel x:Name="GrpToolsItems" Margin="10,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpTools, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavOptimize" Style="{StaticResource NavItem}" Tag="PageOptimize" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F3;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Otimização" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" Tag="PageStartup" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Inicialização" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Tag="PageApps" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE719;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Instalar apps" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <ToggleButton x:Name="GrpMaker" Style="{StaticResource NavGroup}" Content="OFICINA"/>
                            <StackPanel x:Name="GrpMakerItems" Margin="10,0,0,4" Visibility="{Binding IsChecked, ElementName=GrpMaker, Converter={StaticResource BoolVis}}">
                            <RadioButton x:Name="NavMakerPorts" Style="{StaticResource NavItem}" Tag="PageMakerPorts" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE88E;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Portas COM" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavMakerDrv" Style="{StaticResource NavItem}" Tag="PageMakerDrv" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE950;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock Text="Drivers seriais" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Line}" Margin="22,10,22,6"/>
                            <RadioButton x:Name="NavNet" Style="{StaticResource NavItem}" Tag="PageNet" Checked="Nav_Checked">
                                <DockPanel>
                                    <TextBlock Text="&#xE839;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="rede" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <TextBlock Text="Radar" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavOverlay" Style="{StaticResource NavItem}" Tag="PageOverlay" Checked="Nav_Checked">
                                <DockPanel>
                                    <TextBlock Text="&#xE81E;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="overlay" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <TextBlock Text="Vigia" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDriver" Style="{StaticResource NavItem}" Tag="PageDriver" Checked="Nav_Checked">
                                <DockPanel>
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="drivers" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <TextBlock Text="Alicerce" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavInteg" Style="{StaticResource NavItem}" Tag="PageInteg" Checked="Nav_Checked">
                                <DockPanel>
                                    <TextBlock Text="&#xE790;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="RGB" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <TextBlock Text="Prisma" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavVault" Style="{StaticResource NavItem}" Tag="PageVault" Checked="Nav_Checked">
                                <DockPanel>
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="senhas" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <TextBlock Text="Cofre" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavPdf" Style="{StaticResource NavItem}" Tag="PagePdf" Checked="Nav_Checked">
                                <DockPanel>
                                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="PDF" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                    <TextBlock Text="Prensa" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavShield" Style="{StaticResource NavItem}" IsEnabled="False" ToolTip="Antivírus offline: em breve">
                                <DockPanel>
                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Danger}" BorderThickness="1" CornerRadius="3" Padding="5,0" Margin="6,0,4,0" VerticalAlignment="Center">
                                        <TextBlock Text="EM BREVE" Foreground="{DynamicResource Danger}" FontFamily="{StaticResource Mono}" FontSize="9"/>
                                    </Border>
                                    <TextBlock Text="Muralha" VerticalAlignment="Center"/>
                                </DockPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Conteúdo ===== -->
            <Grid Grid.Row="1" Grid.Column="1">

                <!-- ===== VISÃO GERAL (painel) ===== -->
                <ScrollViewer x:Name="PageDash" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,6,24,20">

                        <!-- Cabeçalho do Painel: nome do módulo + assinatura da marca -->
                        <Grid Margin="4,2,0,18">
                            <StackPanel>
                                <TextBlock Text="PAINEL" Style="{StaticResource H1}"/>
                                <TextBlock Text="Seu PC, blindado. Inviolável, offline e tudo em um só lugar." Style="{StaticResource Sub}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="OFFLINE · SEM TELEMETRIA" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Linha 1: gráfico grande + desempenho -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardBorder}" Padding="24,20">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="DashChartLabel" Text="CPU · TEMPERATURA" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="DashChartDelta" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                            <TextBlock x:Name="DashChartValue" Text="—" Style="{StaticResource Hero}" FontFamily="{StaticResource Mono}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                            <TextBlock Text="GPU" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="DashChartValue2" Text="—" FontFamily="{StaticResource Mono}" FontSize="22"
                                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,16,0,8">
                                        <StackPanel x:Name="DashRangePanel" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashRange" Content="1 MIN" Tag="60" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashRange" Content="5 MIN" Tag="300" IsChecked="True" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashRange" Content="15 MIN" Tag="900" Checked="DashOption_Checked"/>
                                        </StackPanel>
                                        <StackPanel x:Name="DashMetricPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashMetric" Content="Temperatura" Tag="temp" IsChecked="True" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashMetric" Content="Carga" Tag="load" Checked="DashOption_Checked"/>
                                            <RadioButton Style="{StaticResource Chip}" GroupName="DashMetric" Content="Consumo" Tag="power" Checked="DashOption_Checked"/>
                                        </StackPanel>
                                    </Grid>
                                    <Canvas x:Name="DashChart" Height="210" ClipToBounds="True" SizeChanged="DashChart_SizeChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Rectangle Width="14" Height="2" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="CPU" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                                        <Line X1="0" X2="14" Stroke="{DynamicResource Muted}" StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="GPU" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Desempenho (como o "Total Balance" da referência) -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="22,20">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="RODAR BENCHMARK" Margin="0,14,0,0"
                                            Padding="20,13" Click="DashBench_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="DESEMPENHO · FORJA" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <TextBlock x:Name="DashScore" Text="—" Style="{StaticResource Hero}"/>
                                            <TextBlock x:Name="DashScoreDelta" Foreground="{DynamicResource Muted}" FontSize="12"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="DashScoreSub" Text="multi-core · nenhum teste ainda" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,0"/>
                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,16"/>
                                        <ItemsControl x:Name="DashScores" ItemTemplate="{StaticResource KeyValueRow}"/>
                                        <!-- Caixa interna, como o widget de troca da referência -->
                                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                                                Padding="14,4" Margin="0,14,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,10">
                                                    <TextBlock Text="CPU" Foreground="{DynamicResource Muted}"/>
                                                    <TextBlock x:Name="DashCpuName" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="50,0,0,0"/>
                                                </Grid>
                                                <Border Height="1" Background="{DynamicResource Line}"/>
                                                <Grid Margin="0,10">
                                                    <TextBlock Text="GPU" Foreground="{DynamicResource Muted}"/>
                                                    <TextBlock x:Name="DashGpuName" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="50,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Linha 2: tabela de componentes -->
                        <Border Style="{StaticResource CardBorder}" Padding="22,14,22,8" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="COMPONENTE" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="TEMPERATURA" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="2" Text="CARGA" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="3" Text="CLOCK" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="4" Text="CONSUMO / USO" Style="{StaticResource Label}" Margin="0"/>
                                    <TextBlock Grid.Column="5" Text="VER" Style="{StaticResource Label}" Margin="0" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl x:Name="DashComponents">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="56"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Hover}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                            <TextBlock Text="{Binding Model}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Temp}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Load}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Clock}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Power}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="5" Style="{StaticResource CaptionButton}" Width="30" Height="30" Content="&#xE72A;"
                                                            HorizontalAlignment="Right" Tag="{Binding Target}" Click="DashGo_Click" ToolTip="Abrir detalhes"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Linha 3: anéis de memória, eventos e saúde -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Anéis concêntricos (como o "Annual Profit" da referência) -->
                            <Border Style="{StaticResource CardBorder}" Padding="22,20">
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA E DISCO" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DashMemHero" Text="—" Style="{StaticResource Hero}" FontFamily="{StaticResource Mono}" FontSize="28"/>
                                    <TextBlock x:Name="DashMemSub" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,8"/>
                                    <Canvas x:Name="DashRings" Width="190" Height="190" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                    <ItemsControl x:Name="DashRingLegend">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="12" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Eventos recentes (como "Transactions") -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="22,20">
                                <StackPanel>
                                    <TextBlock Text="Eventos recentes" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="DashEventsEmpty" Text="Nada ainda. Benchmarks, testes e dispositivos conectados aparecem aqui."
                                               Foreground="{DynamicResource Faint}" TextWrapping="Wrap" FontSize="12"/>
                                    <ItemsControl x:Name="DashEvents">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource AccentText}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding When}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Saúde do PC (como "Rewards"): lista de verificação + ação -->
                            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="22,20">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="OTIMIZAR AGORA" Padding="20,13"
                                            Margin="0,14,0,0" Click="DashOptimize_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="Saúde do PC" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="DashHealth">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,11">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="chk" Text="&#xE739;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Faint}"
                                                                       Margin="0,0,12,0" VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter TargetName="chk" Property="Text" Value="&#xE73D;"/>
                                                        <Setter TargetName="chk" Property="Foreground" Value="{DynamicResource Fg}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== SISTEMA ===== -->
                <local:SystemView x:Name="PageSystem" Visibility="Collapsed"/>

                <!-- ===== DISCOS (saúde) ===== -->
                <local:DisksView x:Name="PageDisks" Visibility="Collapsed"/>

                <!-- ===== ENERGIA (bateria e fonte) ===== -->
                <local:EnergyView x:Name="PageEnergy" Visibility="Collapsed"/>

                <!-- ===== REDE (diagnóstico de lag) ===== -->
                <local:RadarView x:Name="PageNet" Visibility="Collapsed"/>

                <!-- ===== ALICERCE ===== -->
                <local:DriversView x:Name="PageDriver" Visibility="Collapsed"/>

                <!-- ===== PRISMA (iluminação) ===== -->
                <local:PrismaView x:Name="PageInteg" Visibility="Collapsed"/>

                <!-- ===== ARENA (inicializador) ===== -->
                <local:LauncherView x:Name="PageLauncher" Visibility="Collapsed"/>

                <!-- ===== SENSORES ===== -->
                <local:SensorsView x:Name="PageSensors" Visibility="Collapsed"/>

                <!-- ===== PLACA DE VÍDEO ===== -->
                <local:GpuView x:Name="PageGpu" Visibility="Collapsed"/>

                <!-- ===== JOGOS ===== -->
                <local:GamesView x:Name="PageGames" Visibility="Collapsed"/>

                <!-- ===== GARGALO ===== -->
                <local:BottleneckView x:Name="PageBottleneck" Visibility="Collapsed"/>

                <!-- ===== OVERLAY ===== -->
                <local:OverlayView x:Name="PageOverlay" Visibility="Collapsed"/>

                <!-- ===== FORJA ===== -->
                <local:BenchView x:Name="PageBench" Visibility="Collapsed"/>

                <!-- ===== ARSENAL · OTIMIZAÇÃO ===== -->
                <local:OptimizeView x:Name="PageOptimize" Visibility="Collapsed"/>

                <!-- ===== INICIALIZAÇÃO (programas que abrem com o Windows) ===== -->
                <local:StartupView x:Name="PageStartup" Visibility="Collapsed"/>

                <!-- ===== INSTALAR APPS (pós-formatação, via winget) ===== -->
                <local:AppsView x:Name="PageApps" Visibility="Collapsed"/>

                <!-- ===== VAULT DE SENHAS (UserControl em Modules\Vault) ===== -->
                <local:VaultView x:Name="PageVault" Visibility="Collapsed"/>

                <!-- ===== PDF (UserControl em Modules\Pdf) ===== -->
                <local:PdfView x:Name="PagePdf" Visibility="Collapsed"/>

                <!-- ===== OFICINA · Portas COM (fantasmas e números COM presos) ===== -->
                <local:PortsView x:Name="PageMakerPorts" Visibility="Collapsed"/>

                <!-- ===== OFICINA · Drivers seriais (CH340, CP210x, FTDI, Prolific, Arduino) ===== -->
                <local:SerialDriversView x:Name="PageMakerDrv" Visibility="Collapsed"/>

                <!-- ===== FORJA · OVERCLOCK ===== -->
                <local:OcView x:Name="PageOc" Visibility="Collapsed"/>

                <!-- ===== STRESS TEST ===== -->
                <local:StressView x:Name="PageStress" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
