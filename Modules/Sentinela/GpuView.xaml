<UserControl x:Class="FortKnox.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FortKnox.UI">
    <!-- SENTINELA · Placa de vídeo (Fase 3.3l: extraído do MainWindow.xaml, sem mudança visual) -->
    <Grid Margin="36,30,36,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SENTINELA · PLACA DE VÍDEO" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource InfoTip}" ToolTip="Especificações completas e sensores em tempo real"/>
                </StackPanel>
            </StackPanel>
            <WrapPanel x:Name="GpuChips" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Destaque -->
        <ui:ChamferBorder Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="24,20">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="GpuName" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GpuSubtitle" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="GpuVendor" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="30" FontWeight="Black" Foreground="{DynamicResource Faint}"/>
            </Grid>
        </ui:ChamferBorder>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl x:Name="GpuSections" ItemTemplate="{StaticResource GpuSection}"/>
            </ScrollViewer>

            <!-- Sensores (equivalente à aba Sensors do GPU-Z) -->
            <ui:ChamferBorder Grid.Column="2" Style="{StaticResource Card}" Padding="20,16,12,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SENSORES AO VIVO" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="GpuExtras" DockPanel.Dock="Top" Margin="0,0,8,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GpuLive" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,6">
                                        <Grid>
                                            <TextBlock>
                                                <Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource Faint}"/>
                                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </ui:ChamferBorder>
        </Grid>
    </Grid>
</UserControl>
