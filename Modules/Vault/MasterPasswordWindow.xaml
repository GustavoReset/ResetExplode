<Window x:Class="FortKnox.MasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FortKnox.UI"
        Title="Fort Knox · Cofre" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        FontFamily="{StaticResource Text}" TextOptions.TextFormattingMode="Display">
    <ui:ChamferBorder Margin="24" Width="420" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" ClipContent="False" Padding="24,22">
        <ui:ChamferBorder.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
        </ui:ChamferBorder.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <ui:ChamferBorder Width="34" Height="34" Cut="4" Background="{StaticResource GoldButton}" Margin="0,0,14,0">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#0B0C0E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ui:ChamferBorder>
                <TextBlock Text="Abrir o Cofre" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="Hint" FontSize="13" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="48,8,0,14"
                       Text="Digite a senha mestra para ver suas senhas."/>
            <PasswordBox x:Name="Pwd" Margin="48,0,0,0" KeyDown="Pwd_KeyDown"/>
            <TextBlock x:Name="Error" FontSize="12" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="48,8,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="DevNote" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{DynamicResource Warn}" Margin="48,10,0,0"
                       Text="VERSÃO DE TESTE · senha provisória" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource OutlineButtonSm}" Content="Cancelar" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="BtnOpen" Style="{StaticResource PrimaryButtonSm}" Content="Abrir" Click="Open_Click"/>
            </StackPanel>
        </StackPanel>
    </ui:ChamferBorder>
</Window>
