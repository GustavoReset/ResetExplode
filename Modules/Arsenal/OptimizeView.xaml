<UserControl x:Class="FortKnox.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ARSENAL · Otimização (Fase 3.3k: extraído do MainWindow.xaml, sem mudança visual) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30">
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="ARSENAL · OTIMIZAÇÃO" Style="{StaticResource H1}"/>
                <TextBlock Text="Libera memória, fecha o que atrapalha e ajusta o Windows para jogos" Style="{StaticResource Sub}"/>
            </StackPanel>

            <!-- Botão principal -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <Grid>
                            <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="OptRamText" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Height="6" Background="{DynamicResource Line}" Margin="0,0,0,12">
                            <Border Background="{StaticResource GoldGradient}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="OptRamBar" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap">
                            Um clique: limpa a memória em espera e fecha os programas marcados na lista abaixo.
                            Use antes de abrir um jogo.
                        </TextBlock>
                        <TextBlock x:Name="OptResult" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnOptimize" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="OTIMIZAR AGORA"
                            FontSize="16" Padding="34,16" VerticalAlignment="Center" Click="BtnOptimize_Click"/>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Programas -->
                <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="PROGRAMAS PARA FECHAR" Style="{StaticResource Label}"/>
                            <Button Style="{StaticResource OutlineButton}" Content="ATUALIZAR" Padding="10,4" FontSize="11"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnRefreshApps_Click"/>
                        </Grid>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                            Marcados = seguros de fechar durante o jogo. Programas com janela recebem o pedido de
                            fechar (como clicar no X) e não são forçados, para não perder nada não salvo.
                        </TextBlock>
                        <ItemsControl x:Name="OptApps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding MemoryText}" FontFamily="{StaticResource Mono}"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Ajustes do Windows -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="AJUSTES DO WINDOWS PARA JOGOS" Style="{StaticResource Label}"/>
                            <Button Style="{StaticResource OutlineButton}" Content="RESTAURAR ORIGINAIS" Padding="10,4" FontSize="11"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnRestoreTweaks_Click"/>
                        </Grid>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                            O interruptor mostra o estado atual e aplica na hora. O valor original é guardado na primeira
                            alteração. Não mexemos em segurança (Defender, Integridade de Memória, UAC, Windows Update).
                        </TextBlock>
                        <ItemsControl x:Name="OptTweaks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsOn, Mode=OneWay}" Tag="{Binding}" Click="Tweak_Click"
                                                      VerticalAlignment="Top" Margin="0,1,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,110,0"/>
                                                    <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Effect}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
