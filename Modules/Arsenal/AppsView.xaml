<UserControl x:Class="FortKnox.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FortKnox.UI">
    <!-- ARSENAL · Instalar apps (Fase 3.3: extraído do MainWindow.xaml, sem mudança visual) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30">
            <Grid Margin="0,0,0,20">
                <StackPanel Margin="0,0,250,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ARSENAL · INSTALAR APPS" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource InfoTip}" ToolTip="Os essenciais depois de formatar o PC · versão oficial mais recente, instalação silenciosa"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="BtnAppsInstall" Style="{StaticResource PrimaryButton}" Content="INSTALAR SELECIONADOS" Padding="20,9"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnAppsInstall_Click"/>
            </Grid>
            <Grid Height="3" Margin="0,0,0,8" Background="{DynamicResource Line}">
                <Border Background="{StaticResource GoldGradient}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="AppsProgress" ScaleX="0"/></Border.RenderTransform>
                </Border>
            </Grid>
            <ui:StatusLine x:Name="AppsStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <ui:ChamferBorder Style="{StaticResource FkCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="APPS" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource InfoTip}" FontSize="12" VerticalAlignment="Top" Margin="8,-1,0,0" ToolTip="Usa o winget, o instalador de pacotes da Microsoft que já vem no Windows 10/11: baixa do site oficial de cada fabricante e confere o arquivo antes de instalar. Os apps são instalados um de cada vez, sem janelas. O que já está instalado aparece marcado como INSTALADO."/>
                        </StackPanel>
                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource OutlineButton}" Content="MARCAR TODOS" Padding="10,4" FontSize="11" Margin="0,0,8,0" Click="BtnAppsAll_Click"/>
                            <Button Style="{StaticResource OutlineButton}" Content="DESMARCAR" Padding="10,4" FontSize="11" Click="BtnAppsNone_Click"/>
                        </WrapPanel>
                    </Grid>
                    <ItemsControl x:Name="AppsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTip="{Binding Description}" Cursor="Help"/>
                                            <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Top" Margin="14,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Installed}" Value="True">
                                                            <Setter Property="Text" Value="INSTALADO"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="BtnAppsStore" Style="{StaticResource OutlineButton}" Content="ATUALIZAR O INSTALADOR DE APLICATIVO (MICROSOFT STORE)"
                            Padding="14,7" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed" Click="BtnAppsStore_Click"/>
                </StackPanel>
            </ui:ChamferBorder>
        </StackPanel>
    </ScrollViewer>
</UserControl>
