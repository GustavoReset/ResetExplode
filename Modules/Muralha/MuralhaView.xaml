<UserControl x:Class="FortKnox.MuralhaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FortKnox.UI">
    <!-- MURALHA · Varredura (Fases 3.5a/3.5b): motor em camadas com YARA, varredura completa, quarentena cifrada. Complementa o Defender. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30">
            <Grid Margin="0,0,0,20">
                <StackPanel Margin="0,0,420,0">
                    <TextBlock Text="MURALHA · VARREDURA" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="Summary" Style="{StaticResource Sub}" TextWrapping="Wrap"
                               Text="Proteção complementar ao Microsoft Defender · nada sai do lugar sem você confirmar"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="BtnFolder" Style="{StaticResource OutlineButton}" Content="Verificar uma pasta…" Padding="16,9" Margin="0,0,8,0" Click="BtnFolder_Click"/>
                    <Button x:Name="BtnFull" Style="{StaticResource OutlineButton}" Content="Varredura completa" Padding="16,9" Click="BtnFull_Click"/>
                </StackPanel>
            </Grid>

            <ui:ScannerPanel x:Name="Scanner" Title="MURALHA · VARREDURA RÁPIDA" StartText="Verificar agora" Margin="0,0,0,16"/>

            <!-- Itens encontrados -->
            <Border x:Name="ThreatCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Margin="0,0,260,0">
                            <TextBlock x:Name="ThreatTitle" Text="ITENS ENCONTRADOS" Style="{StaticResource Label}"/>
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                                       Text="Item suspeito não é diagnóstico: leia o motivo. Na quarentena o arquivo fica cifrado e pode voltar quando quiser."/>
                        </StackPanel>
                        <Button x:Name="BtnQuarantineAll" Style="{StaticResource DangerButtonSm}" Content="Tudo para a quarentena"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnQuarantineAll_Click"/>
                    </Grid>
                    <ItemsControl x:Name="ThreatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:StatusBadge Status="{Binding Status}" Text="{Binding VerdictText}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Path}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Faint}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                            <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AccentText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource OutlineButtonSm}" Content="Ignorar" Margin="0,0,8,0" Tag="{Binding}" Click="BtnIgnore_Click"
                                                    IsEnabled="{Binding Pending}"/>
                                            <Button Style="{StaticResource OutlineButtonSm}" Content="Confiar sempre" Margin="0,0,8,0" Tag="{Binding}" Click="BtnTrust_Click"
                                                    IsEnabled="{Binding Pending}" ToolTip="Não acusar mais este arquivo (enquanto o conteúdo dele não mudar)"/>
                                            <Button Style="{StaticResource DangerButtonSm}" Content="Quarentena" Tag="{Binding}" Click="BtnQuarantine_Click"
                                                    IsEnabled="{Binding Pending}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Quarentena -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock x:Name="QuarantineTitle" Text="QUARENTENA" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="QuarantineEmpty" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Text="Nada na quarentena. Itens colocados aqui ficam cifrados (não rodam nem abrem) e podem voltar para o lugar de origem."/>
                    <ItemsControl x:Name="QuarantineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding OriginalPath}" FontFamily="{StaticResource Mono}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding OriginalPath}"/>
                                            <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding QuarantinedAt, StringFormat='Na quarentena desde {0:dd/MM/yyyy HH:mm}'}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource OutlineButtonSm}" Content="Restaurar" Margin="0,0,8,0" Tag="{Binding}" Click="BtnRestore_Click"/>
                                            <Button Style="{StaticResource DangerButtonSm}" Content="Excluir de vez" Tag="{Binding}" Click="BtnDelete_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Footer" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <Button x:Name="BtnForgetTrusted" Style="{StaticResource OutlineButtonSm}" Content="Esquecer arquivos confiáveis" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Visibility="Collapsed" Click="BtnForgetTrusted_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
