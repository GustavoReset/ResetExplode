<Window x:Class="FortKnox.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FortKnox.UI"
        Title="Fort Knox aviso" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Opacity="0">
    <ui:ChamferBorder Background="#F2111316" BorderBrush="#80D4A13A" BorderThickness="1" Cut="6" Padding="16,12" Width="340">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:ChamferBorder Width="34" Height="34" Background="{StaticResource GoldButton}" Cut="4" VerticalAlignment="Top" Margin="0,2,14,0">
                <TextBlock x:Name="TIcon" Text="&#xE88E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                           Foreground="#0B0C0E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ui:ChamferBorder>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TTitle" Foreground="#F6F5F1" FontFamily="{StaticResource Text}" FontSize="13.5"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="TText" Foreground="#9AA0A9" FontFamily="{StaticResource Text}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                <Image Source="{StaticResource BrandWordmark}" Height="7" HorizontalAlignment="Left" Margin="0,8,0,0" Opacity="0.8"/>
            </StackPanel>
        </Grid>
    </ui:ChamferBorder>
</Window>
