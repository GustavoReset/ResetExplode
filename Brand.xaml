    <!-- ===== Marca Fort Knox (gerado da identidade visual v3; não editar à mão) =====
         Símbolo "Bastião": planta de forte estrelado de 5 baluartes, muralha dupla em ouro e núcleo pentagonal vermelho.
         Logotipo: FORT ⬟ KNOX em Michroma convertida em curvas (não depende da fonte instalada). -->

    <!-- Degradês oficiais -->
    <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F7D98A"/><GradientStop Offset="0.55" Color="#D4A13A"/><GradientStop Offset="1" Color="#8C6420"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldMetal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FBE6A6"/><GradientStop Offset="0.42" Color="#E2B04D"/><GradientStop Offset="0.5" Color="#B8842A"/>
        <GradientStop Offset="0.62" Color="#D9A441"/><GradientStop Offset="1" Color="#F3D27C"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldButton" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F3CF72"/><GradientStop Offset="0.5" Color="#D9A53E"/><GradientStop Offset="1" Color="#B8842A"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RedGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F0475A"/><GradientStop Offset="1" Color="#A3122A"/>
    </LinearGradientBrush>

