    <!-- Símbolo colorido: muralha em degradê ouro, núcleo vermelho -->
    <DrawingImage x:Key="BrandSymbol">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L100,0 L100,104 L0,104 Z"/>
                <GeometryDrawing Brush="{StaticResource GoldGradient}" Geometry="{StaticResource BastionWall}"/>
                <GeometryDrawing Brush="{StaticResource RedGradient}" Geometry="{StaticResource BastionCore}"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Logotipo em ouro metálico com separador vermelho -->
    <DrawingImage x:Key="BrandWordmark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource GoldMetal}" Geometry="{StaticResource WordmarkLetters}"/>
                <GeometryDrawing Brush="{StaticResource RedGradient}" Geometry="{StaticResource WordmarkSeparator}"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
