<Window x:Class="FortKnox.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FortKnox.UI"
        Title="Fort Knox · Configurações" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        FontFamily="{StaticResource Text}" Foreground="{DynamicResource Fg}" TextOptions.TextFormattingMode="Display">
    <Border Margin="24" Width="520" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}" Padding="26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <TextBlock Text="CONFIGURAÇÕES" Style="{StaticResource H1}" FontSize="17"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Fechar" HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>

            <TextBlock Text="COFRE · ABERTURA" Style="{StaticResource SectionHeader}" Margin="0,22,0,10"/>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="16,14">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,70,0">
                            <TextBlock Text="Usar o Windows Hello" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Rosto, digital ou PIN do Windows para abrir o Cofre. Desligado, o Cofre pede a senha mestra."
                                       Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkHello" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="False"
                                  Click="ChkHello_Click" AutomationProperties.Name="Usar o Windows Hello"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:StatusBadge x:Name="HelloBadge" Status="Neutro" Text="Verificando…" Margin="0,0,10,0"/>
                        <TextBlock x:Name="HelloText" Style="{StaticResource Sub}" Margin="0" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="330"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="DevNote" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{DynamicResource Warn}" Margin="0,12,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Text="VERSÃO DE TESTE · a senha mestra é provisória e será definida por você na versão final."/>

            <Button Style="{StaticResource PrimaryButtonSm}" Content="Pronto" HorizontalAlignment="Right" Margin="0,22,0,0" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>
